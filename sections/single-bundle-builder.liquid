      "default": false,
      "visible_if": "{{ section.settings.allow_transparent_header }}"
    },
  ],
  "blocks": [
    {
      "type": "gallery",
      "name": "Galleria",
      "limit": 1,
      "settings": [
        { "type": "header", "content": "Bottone indossato" },
        { "type": "text",   "id": "worn_btn_label",      "label": "Testo (prodotto → indossato)", "default": "Vedi indossato" },
        { "type": "text",   "id": "worn_btn_back_label", "label": "Testo (indossato → prodotto)",  "default": "Vista prodotto" },
        {
          "type": "select", "id": "worn_btn_style", "label": "Stile bottone",
          "options": [
            { "value": "solid",   "label": "Solid" },
            { "value": "outline", "label": "Outline" },
            { "value": "link",    "label": "Link" }
          ],
          "default": "solid"
        },
        { "type": "header", "content": "Mobile" },
        { "type": "range", "id": "worn_btn_font_size",  "label": "Font size",             "min": 10, "max": 22, "step": 1, "unit": "px", "default": 13 },
        { "type": "range", "id": "worn_btn_bottom",     "label": "Distanza dal basso",    "min": 8,  "max": 80, "step": 2, "unit": "px", "default": 22 },
        { "type": "range", "id": "worn_btn_pad_v",      "label": "Padding verticale",     "min": 4,  "max": 24, "step": 2, "unit": "px", "default": 8 },
        { "type": "range", "id": "worn_btn_pad_h",      "label": "Padding orizzontale",   "min": 8,  "max": 40, "step": 2, "unit": "px", "default": 18 },
        { "type": "color",  "id": "worn_btn_bg",        "label": "Sfondo" },
