      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "dropdown_border_color",
      "label": "Colore bordo",
      "default": "#e0e0e0"
    },
    {
