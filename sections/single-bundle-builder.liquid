{% schema %}
{
  "name": "Single Bundle Builder",
  "settings": [
    {
      "type": "header",
      "content": "Aspetto sezione"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Colore sfondo sezione (override)"
    },
    {
      "type": "header",
      "content": "Colonna destra"
    },
    {
      "type": "range",
      "id": "info_pad_top",
      "label": "Padding superiore",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "info_pad_right",
      "label": "Padding destro",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "info_pad_bottom",
      "label": "Padding inferiore",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "info_pad_left",
      "label": "Padding sinistro",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "info_col_max_width",
      "label": "Larghezza massima colonna destra (desktop)",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 540
    },
    {
      "type": "select",
      "id": "info_col_position",
      "label": "Posizione colonna destra (desktop)",
      "options": [
        { "value": "left",   "label": "Sinistra" },
        { "value": "center", "label": "Centro" },
        { "value": "right",  "label": "Destra" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "sticky_info_col",
      "label": "Colonna destra fissa (sticky) su desktop",
      "default": true
    },
    {
      "type": "header",
      "content": "Bordo Dropdown"
    },
    {
      "type": "range",
      "id": "dropdown_border_width",
