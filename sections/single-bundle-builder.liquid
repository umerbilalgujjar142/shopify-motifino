        { "type": "range", "id": "worn_btn_bottom_desk",    "label": "Distanza dal basso","min": 8,  "max": 80, "step": 2, "unit": "px", "default": 40 },
        { "type": "range", "id": "worn_btn_pad_v_desk",     "label": "Padding verticale", "min": 4,  "max": 24, "step": 2, "unit": "px", "default": 8 },
