{%- assign bsc_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

{%- if section.settings.use_custom_section_spacing -%}
  <style>
    #shopify-section-{{ section.id }} .section-spacing {
      padding-block-start: {{ section.settings.mobile_section_spacing_top | default: 40 }}px;
      padding-block-end: {{ section.settings.mobile_section_spacing_bottom | default: 40 }}px;
      padding-inline-start: {{ section.settings.mobile_section_spacing_left | default: 20 }}px;
      padding-inline-end: {{ section.settings.mobile_section_spacing_right | default: 20 }}px;
    }
    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .section-spacing {
        padding-block-start: {{ section.settings.desktop_section_spacing_top | default: 60 }}px;
        padding-block-end: {{ section.settings.desktop_section_spacing_bottom | default: 60 }}px;
        padding-inline-start: {{ section.settings.desktop_section_spacing_left | default: 0 }}px;
        padding-inline-end: {{ section.settings.desktop_section_spacing_right | default: 0 }}px;
      }
    }
  </style>
{%- endif -%}

<style>
  @media screen and (max-width: 599px) {
    #shopify-section-{{ section.id }} .container {
      margin-inline-end: auto;
    }
    #shopify-section-{{ section.id }} .section-spacing {
      overflow-x: clip;
    }
    #shopify-section-{{ section.id }} .bsc-nav-btn {
      display: none;
    }
  }

  #shopify-section-{{ section.id }} .bsc-nav-wrapper {
    position: relative;
  }

  @media screen and (min-width: 600px) {
    #shopify-section-{{ section.id }} .bsc-nav-wrapper {
      padding-inline-start: 16px;
      padding-inline-end: 16px;
    }
  }

  #shopify-section-{{ section.id }} .bsc-carousel {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-block-end: 4px;
  }

  @media screen and (max-width: 599px) {
    #shopify-section-{{ section.id }} .bsc-carousel {
      margin-inline-start: calc(-1 * var(--distance-to-bleed));
      margin-inline-end: calc(-1 * var(--distance-to-bleed));
      padding-inline-start: var(--distance-to-bleed);
      padding-inline-end: 0;
      scroll-padding-inline-start: 16px;
      scroll-padding-inline-end: var(--distance-to-bleed);
    }
    #shopify-section-{{ section.id }} .bsc-carousel::after {
      content: '';
      flex: 0 0 var(--distance-to-bleed);
      display: block;
    }
  }

  #shopify-section-{{ section.id }} .bsc-carousel::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .bsc-card {
    flex: 0 0 calc(62.5% - 23px);
    scroll-snap-align: start;
    scroll-snap-stop: always;
    background: #f7f6f4;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  @media screen and (min-width: 600px) {
    #shopify-section-{{ section.id }} .bsc-card {
      flex: 0 0 calc(50% - 8px);
    }
  }

  @media screen and (min-width: 900px) {
    #shopify-section-{{ section.id }} .bsc-card {
      flex: 0 0 calc(33.333% - 11px);
    }
  }

  @media screen and (min-width: 1200px) {
    #shopify-section-{{ section.id }} .bsc-card {
      flex: 0 0 calc(25% - 12px);
    }
  }

  #shopify-section-{{ section.id }} .bsc-carousel.bsc-carousel--centered {
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .bsc-card__image {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    position: relative;
  }

  #shopify-section-{{ section.id }} .bsc-expand-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(4px);
    cursor: pointer;
    display: grid;
    place-content: center;
    z-index: 2;
    padding: 0;
    opacity: 0;
    transition: opacity 0.2s;
  }

  @media (hover: none) {
    #shopify-section-{{ section.id }} .bsc-expand-btn {
      opacity: 1;
    }
  }

  @media (hover: hover) {
    #shopify-section-{{ section.id }} .bsc-card:hover .bsc-expand-btn {
      opacity: 1;
    }
  }

  .bsc-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bsc-modal[hidden] { display: none; }

  .bsc-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
  }

  .bsc-modal__content {
    position: relative;
    width: calc(100vw - 48px);
    max-width: 640px;
    max-height: calc(100vh - 48px);
    background: #fff;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    cursor: grab;
    padding: 16px;
    box-sizing: border-box;
  }

  @media screen and (min-width: 750px) {
    .bsc-modal__content {
      width: 85vw;
      max-width: 85vw;
      height: 85vh;
      max-height: 85vh;
    }
  }

  .bsc-modal__content.is-grabbing { cursor: grabbing; }

  .bsc-modal__img {
    display: block;
    max-width: 100%;
    max-height: calc(100vh - 80px);
    object-fit: contain;
    border-radius: 8px;
    transform-origin: center center;
    will-change: transform;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .bsc-modal__close {
    position: fixed;
    top: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    cursor: pointer;
    display: grid;
    place-content: center;
    padding: 0;
    z-index: 1;
  }

  .bsc-modal__close:hover {
    background: #fff;
  }

  #shopify-section-{{ section.id }} .bsc-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  #shopify-section-{{ section.id }} .bsc-card:hover .bsc-card__image img {
    transform: scale(1.04);
  }

  #shopify-section-{{ section.id }} .bsc-card__body {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .bsc-sizes {
    position: absolute;
    bottom: 10px;
    left: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .bsc-size-btn {
    border: 1.5px solid #ddd;
    background: #fff;
    border-radius: 999px;
    padding: 4px 8px;
    font-size: 11px;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    font-family: inherit;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .bsc-size-btn.is-active,
  #shopify-section-{{ section.id }} .bsc-size-btn:hover {
    border-color: #000;
    background: #000;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .bsc-price {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .bsc-price__sale {
    font-size: 15px;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .bsc-price__compare {
    font-size: 13px;
    color: #c0392b;
    text-decoration: line-through;
  }

  #shopify-section-{{ section.id }} .bsc-atc-btn {
    width: 100%;
    background: #000;
    color: #fff;
    border: none;
    border-radius: 999px;
    padding: 9px 10px;
    font-size: 11px;
    font-weight: 500;
    cursor: pointer;
    font-family: inherit;
    transition: opacity 0.2s, background 0.2s;
    text-align: center;
  }

  @media screen and (min-width: 600px) {
    #shopify-section-{{ section.id }} .bsc-atc-btn {
      padding: 10px 16px;
      font-size: 14px;
    }
  }

  #shopify-section-{{ section.id }} .bsc-atc-btn:hover {
    opacity: 0.85;
  }

  #shopify-section-{{ section.id }} .bsc-atc-btn:disabled {
    opacity: 0.6;
    cursor: default;
  }

  @keyframes bsc-spin { to { transform: rotate(360deg); } }

  #shopify-section-{{ section.id }} .bsc-spinner {
    display: inline-block;
    vertical-align: middle;
    margin-right: 5px;
    animation: bsc-spin 0.7s linear infinite;
  }

  #shopify-section-{{ section.id }} .bsc-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid #e5e5e5;
    background: #fff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    cursor: pointer;
    display: grid;
    place-content: center;
    z-index: 2;
    transition: box-shadow 0.2s;
    padding: 0;
    margin-right: 10px;
  }

  #shopify-section-{{ section.id }} .bsc-nav-btn:hover {
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
  }

  #shopify-section-{{ section.id }} .bsc-nav-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  #shopify-section-{{ section.id }} .bsc-nav-btn--prev {
    left: -4px;
  }

  #shopify-section-{{ section.id }} .bsc-nav-btn--next {
    right: -4px;
  }


</style>

{%- if section.blocks.size > 0 -%}
  {%- comment -%} Mirror the belt-count + tiered-price logic from the cart recap {%- endcomment -%}
  {%- assign bsc_belt_count = 0 -%}
  {%- for bsc_ci in cart.items -%}
    {%- for bsc_p in bsc_ci.properties -%}
      {%- if bsc_p.first contains 'Cintura ' and bsc_p.first contains ' - Pelle' -%}
        {%- assign bsc_belt_count = bsc_belt_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
  {%- if bsc_belt_count == 0 -%}
    {%- assign bsc_next_price_cents = 4999 -%}
  {%- elsif bsc_belt_count == 1 -%}
    {%- assign bsc_next_price_cents = 3499 -%}
  {%- elsif bsc_belt_count == 2 -%}
    {%- assign bsc_next_price_cents = 2499 -%}
  {%- else -%}
    {%- assign bsc_next_price_cents = 2499 -%}
  {%- endif -%}
  {%- assign bsc_full_price_cents = 4999 -%}

  {%- comment -%} Build the set of strap+buckle combos already in the cart, so we don't suggest a belt the customer already added {%- endcomment -%}
  {%- assign bsc_owned_combos = '' -%}
  {%- for bsc_ci in cart.items -%}
    {%- for bsc_p in bsc_ci.properties -%}
      {%- assign bsc_pkey = bsc_p.first -%}
      {%- if bsc_pkey contains 'Cintura ' and bsc_pkey contains ' - Pelle' -%}
        {%- assign bsc_clabel = bsc_pkey | split: ' - ' | first -%}
        {%- assign bsc_fibbia_key = bsc_clabel | append: ' - Fibbia' -%}
        {%- assign bsc_pelle_val = bsc_p.last | strip -%}
        {%- assign bsc_fibbia_val = bsc_ci.properties[bsc_fibbia_key] | strip -%}
        {%- if bsc_pelle_val != blank and bsc_fibbia_val != blank -%}
          {%- assign bsc_owned_combos = bsc_owned_combos | append: bsc_pelle_val | append: '||' | append: bsc_fibbia_val | append: ';;' -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}

  {%- comment -%} Count how many blocks survive the already-owned filter, so we can hide the whole section if none do {%- endcomment -%}
  {%- assign bsc_visible_count = 0 -%}
  {%- for block in section.blocks -%}
    {%- assign bsc_b = block.settings.buckle_slot | default: 'classica' -%}
    {%- assign bsc_s = block.settings.strap_slot  | default: 'nera' -%}
    {%- case bsc_b -%}
      {%- when 'classica' -%}{%- assign bsc_buckle_name = 'Classic Matt' -%}
      {%- when 'silver' -%}{%- assign bsc_buckle_name = 'Elegant Chrome Silver' -%}
      {%- when 'gold' -%}{%- assign bsc_buckle_name = 'Elegant Chrome Gold' -%}
      {%- when 'luxury' -%}{%- assign bsc_buckle_name = 'Mirror Chrome' -%}
    {%- endcase -%}
    {%- case bsc_s -%}
      {%- when 'nera' -%}{%- assign bsc_strap_name = 'Black' -%}
      {%- when 'marrone' -%}{%- assign bsc_strap_name = 'Brown' -%}
      {%- when 'cammello' -%}{%- assign bsc_strap_name = 'Cognac' -%}
      {%- when 'bianca' -%}{%- assign bsc_strap_name = 'White' -%}
      {%- when 'beige' -%}{%- assign bsc_strap_name = 'Sand' -%}
      {%- when 'marronecoccodrillo' -%}{%- assign bsc_strap_name = 'Brown Crocodile' -%}
      {%- when 'neracoccodrillo' -%}{%- assign bsc_strap_name = 'Black Crocodile' -%}
      {%- when 'blu' -%}{%- assign bsc_strap_name = 'Blue' -%}
      {%- when 'grigia' -%}{%- assign bsc_strap_name = 'Gray' -%}
    {%- endcase -%}
    {%- assign bsc_combo_key = bsc_strap_name | append: '||' | append: bsc_buckle_name | append: ';;' -%}
    {%- unless bsc_owned_combos contains bsc_combo_key -%}
      {%- assign bsc_visible_count = bsc_visible_count | plus: 1 -%}
    {%- endunless -%}
  {%- endfor -%}

  {%- assign bsc_all_owned = false -%}
  {%- if bsc_visible_count == 0 and section.blocks.size > 0 -%}
    {%- assign bsc_all_owned = true -%}
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
  <div
    class="section-spacing{% if section.settings.separate_section_with_border %} bordered-section{% endif %} color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ bsc_scheme_hash }}"
  >
    <div class="container container--md">
      <div class="section-stack">
        {%- render 'section-header',
          subheading: section.settings.subheading,
          heading: section.settings.title,
          text_alignment: 'center'
        -%}

        <div class="bsc-nav-wrapper">
          <button
            type="button"
            class="bsc-nav-btn bsc-nav-btn--prev"
            data-bsc-section="{{ section.id }}"
            data-bsc-dir="prev"
            aria-label="Precedente"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          </button>

          <div class="bsc-carousel" id="bsc-carousel-{{ section.id }}">
            {%- assign bsc_shown_count = 0 -%}
            {%- for block in section.blocks -%}
              {%- assign bsc_b = block.settings.buckle_slot | default: 'classica' -%}
              {%- assign bsc_s = block.settings.strap_slot  | default: 'nera' -%}

              {%- case bsc_b -%}
                {%- when 'classica' -%}{%- assign bsc_buckle_name = 'Classic Matt' -%}
                {%- when 'silver' -%}{%- assign bsc_buckle_name = 'Elegant Chrome Silver' -%}
                {%- when 'gold' -%}{%- assign bsc_buckle_name = 'Elegant Chrome Gold' -%}
                {%- when 'luxury' -%}{%- assign bsc_buckle_name = 'Mirror Chrome' -%}
              {%- endcase -%}
              {%- case bsc_s -%}
                {%- when 'nera' -%}{%- assign bsc_strap_name = 'Black' -%}
                {%- when 'marrone' -%}{%- assign bsc_strap_name = 'Brown' -%}
                {%- when 'cammello' -%}{%- assign bsc_strap_name = 'Cognac' -%}
                {%- when 'bianca' -%}{%- assign bsc_strap_name = 'White' -%}
                {%- when 'beige' -%}{%- assign bsc_strap_name = 'Sand' -%}
                {%- when 'marronecoccodrillo' -%}{%- assign bsc_strap_name = 'Brown Crocodile' -%}
                {%- when 'neracoccodrillo' -%}{%- assign bsc_strap_name = 'Black Crocodile' -%}
                {%- when 'blu' -%}{%- assign bsc_strap_name = 'Blue' -%}
                {%- when 'grigia' -%}{%- assign bsc_strap_name = 'Gray' -%}
              {%- endcase -%}
              {%- assign bsc_combo_key = bsc_strap_name | append: '||' | append: bsc_buckle_name | append: ';;' -%}
              {%- unless bsc_all_owned -%}
                {%- if bsc_owned_combos contains bsc_combo_key -%}{%- continue -%}{%- endif -%}
                {%- if bsc_shown_count >= 7 -%}{%- break -%}{%- endif -%}
              {%- endunless -%}
              {%- assign bsc_shown_count = bsc_shown_count | plus: 1 -%}

              {%- assign bsc_lbl1 = section.settings.size_1_label | default: '130cm' -%}
              {%- assign bsc_lbl2 = section.settings.size_2_label | default: '150cm' -%}

              <belt-suggestion-card
                class="bsc-card"
                data-buckle="{{ bsc_b | escape }}"
                data-strap="{{ bsc_s | escape }}"
                {{ block.shopify_attributes }}
              >
                <div class="bsc-card__image">
                  <img
                    src=""
                    alt="Cintura {{ bsc_b | escape }} {{ bsc_s | escape }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                  <button type="button" class="bsc-expand-btn" aria-label="Visualizza immagine">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="5 9 2 12 5 15"/><polyline points="9 5 12 2 15 5"/><polyline points="15 19 12 22 9 19"/><polyline points="19 9 22 12 19 15"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="12" y1="2" x2="12" y2="22"/></svg>
                  </button>
                  <div class="bsc-sizes">
                    <button type="button" class="bsc-size-btn is-active" data-size="130" data-variant-id="">{{ bsc_lbl1 | escape }}</button>
                    <button type="button" class="bsc-size-btn" data-size="150" data-variant-id="">{{ bsc_lbl2 | escape }}</button>
                  </div>
                </div>

                <div class="bsc-card__body">

                  <div class="bsc-price">
                    <span class="bsc-price__sale">{{ bsc_next_price_cents | money }}</span>
                    {%- if bsc_next_price_cents < bsc_full_price_cents -%}
                      <span class="bsc-price__compare">{{ bsc_full_price_cents | money }}</span>
                    {%- endif -%}
                  </div>

                  <button type="button" class="bsc-atc-btn" data-variant-id="">
                    {{ section.settings.atc_button_text | default: 'Aggiungi al Carrello' }}
                  </button>
                </div>
              </belt-suggestion-card>
            {%- endfor -%}
          </div>

          <button
            type="button"
            class="bsc-nav-btn bsc-nav-btn--next"
            data-bsc-section="{{ section.id }}"
            data-bsc-dir="next"
            aria-label="Successivo"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
  {%- endif -%}
{%- endif -%}

<div class="bsc-modal" id="bsc-modal-{{ section.id }}" role="dialog" aria-modal="true" hidden>
  <div class="bsc-modal__backdrop"></div>
  <button type="button" class="bsc-modal__close" aria-label="Chiudi">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  <div class="bsc-modal__content">
    <img class="bsc-modal__img" src="" alt="" width="600" height="600">
  </div>
</div>

{{ 'belt-combination.js' | asset_url | script_tag }}

<script>
  (function () {
    const BUCKLE_MAP = {
      classica: 'buckle-1',
      silver:   'buckle-2',
      gold:     'buckle-3',
      luxury:   'buckle-4'
    };

    const STRAP_MAP = {
      nera:               'strap-nero',
      marrone:            'strap-marrone',
      cammello:           'strap-cognac',
      bianca:             'strap-cuoio',
      beige:              'strap-beige',
      marronecoccodrillo: 'strap-rosso',
      neracoccodrillo:    'strap-verde',
      blu:                'strap-blu',
      grigia:             'strap-grigio'
    };

    function hydrateCards(mediaData) {
      document.querySelectorAll('belt-suggestion-card[data-buckle][data-strap]').forEach(card => {
        const buckleKey = BUCKLE_MAP[card.dataset.buckle];
        const strapKey  = STRAP_MAP[card.dataset.strap];
        if (!buckleKey || !strapKey) return;
        const entry = (mediaData.combinations || {})[strapKey + '__130__' + buckleKey];
        const img   = card.querySelector('img');
        if (img && entry && entry.photo) img.src = entry.photo;
      });
    }

    /* Adds the matching "Combinazione cintura" product (belt + buckle already
       combined) in the selected length, plus one free Privilege Card Black per
       belt. No SET tier product and no hidden component lines — the cart and
       the checkout hold exactly the same items. */
    /* The cart section is rendered back with the add, so nothing reloads. */
    const CART_SECTION = 'main';

    function combinationKeys(card) {
      const buckleKey = BUCKLE_MAP[card.dataset.buckle];
      const strapKey  = STRAP_MAP[card.dataset.strap];
      if (!buckleKey || !strapKey) return null;
      return { strap: strapKey, buckle: buckleKey };
    }

    /* Pull the product JSON while the pointer is still on the card, so the
       click itself only pays for the cart write. */
    function prefetchCard(card) {
      const keys = combinationKeys(card);
      if (keys && window.MotifinoBelt) {
        window.MotifinoBelt.prefetchCombination(keys.strap, keys.buckle);
      }
    }

    async function addCombinationToCart(card) {
      const keys = combinationKeys(card);
      if (!keys) throw new Error('unknown_combination');
      if (!window.MotifinoBelt) throw new Error('belt_combination_js_missing');

      const activeBtn  = card.querySelector('.bsc-size-btn.is-active');
      const activeSize = (activeBtn && activeBtn.dataset.size) || '130';

      const sections = document.getElementById('shopify-section-' + CART_SECTION)
        ? CART_SECTION
        : '';

      const result = await window.MotifinoBelt.addBelt({
        strap:  keys.strap,
        buckle: keys.buckle,
        length: activeSize,
      }, sections);

      if (!sections || !window.MotifinoBelt.renderSections(result, [CART_SECTION])) {
        window.location.reload();
      }
    }

    const mediaUrl = {{ 'bundle-builder-media.json' | asset_url | json }};

    function updateCarouselAlign() {
      const bscEl = document.getElementById('bsc-carousel-{{ section.id }}');
      if (!bscEl) return;
      bscEl.classList.remove('bsc-carousel--centered');
      bscEl.classList.toggle('bsc-carousel--centered', bscEl.scrollWidth <= bscEl.clientWidth);
    }
    updateCarouselAlign();
    if (window.ResizeObserver) {
      const bscEl = document.getElementById('bsc-carousel-{{ section.id }}');
      if (bscEl) new ResizeObserver(updateCarouselAlign).observe(bscEl);
    }

    fetch(mediaUrl)
      .then(r => r.json())
      .then(media => { hydrateCards(media); })
      .catch(() => {});

    if (!customElements.get('belt-suggestion-card')) {
      customElements.define('belt-suggestion-card', class extends HTMLElement {
        connectedCallback() {
          const sizeBtns = this.querySelectorAll('.bsc-size-btn');
          const atcBtn   = this.querySelector('.bsc-atc-btn');

          ['pointerenter', 'touchstart'].forEach(evt => {
            this.addEventListener(evt, () => prefetchCard(this), { once: true, passive: true });
          });

          sizeBtns.forEach(btn => {
            btn.addEventListener('click', () => {
              sizeBtns.forEach(b => b.classList.remove('is-active'));
              btn.classList.add('is-active');
            });
          });

          if (atcBtn) {
            atcBtn.addEventListener('click', async () => {
              const originalHTML = atcBtn.innerHTML;
              atcBtn.disabled = true;
              atcBtn.innerHTML =
                '<svg class="bsc-spinner" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>'
                + atcBtn.textContent.trim();
              try {
                await addCombinationToCart(this);
              } catch (_) {
                /* fall through — the button is restored either way */
              } finally {
                atcBtn.innerHTML = originalHTML;
                atcBtn.disabled  = false;
              }
            });
          }
        }
      });
    }

    (function () {
      const sectionId = '{{ section.id }}';
      const carousel  = document.getElementById('bsc-carousel-' + sectionId);
      const prevBtn   = document.querySelector('[data-bsc-section="' + sectionId + '"][data-bsc-dir="prev"]');
      const nextBtn   = document.querySelector('[data-bsc-section="' + sectionId + '"][data-bsc-dir="next"]');
      if (!carousel || !prevBtn || !nextBtn) return;

      function syncNavBtns() {
        const atStart = carousel.scrollLeft <= 1;
        const atEnd   = carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth - 1;
        prevBtn.disabled = atStart;
        nextBtn.disabled = atEnd;
      }

      prevBtn.addEventListener('click', () => {
        const card = carousel.querySelector('.bsc-card');
        const step = card ? card.offsetWidth + 16 : 320;
        carousel.scrollBy({ left: -step, behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', () => {
        const card = carousel.querySelector('.bsc-card');
        const step = card ? card.offsetWidth + 16 : 320;
        carousel.scrollBy({ left: step, behavior: 'smooth' });
      });

      carousel.addEventListener('scroll', syncNavBtns, { passive: true });
      syncNavBtns();
    })();

    const modal       = document.getElementById('bsc-modal-{{ section.id }}');
    const modalImg    = modal && modal.querySelector('.bsc-modal__img');
    const modalContent = modal && modal.querySelector('.bsc-modal__content');

    let zScale = 1, zX = 0, zY = 0;
    let isDragging = false, dragStartX = 0, dragStartY = 0, dragOriginX = 0, dragOriginY = 0;
    let pinchStartDist = 0, pinchStartScale = 1;

    function clampZoom(v) { return Math.max(1, Math.min(5, v)); }

    function applyZoom() {
      modalImg.style.transform = `translate(${zX}px, ${zY}px) scale(${zScale})`;
      modalContent.style.cursor = zScale > 1 ? (isDragging ? 'grabbing' : 'grab') : 'default';
    }

    function resetZoom() {
      zScale = 1; zX = 0; zY = 0;
      applyZoom();
    }

    function zoomAt(mx, my, factor) {
      const newScale = clampZoom(zScale * factor);
      const ratio = newScale / zScale;
      zX = mx - ratio * (mx - zX);
      zY = my - ratio * (my - zY);
      zScale = newScale;
      if (zScale === 1) { zX = 0; zY = 0; }
      applyZoom();
    }

    function openModal(src, alt) {
      modalImg.src = src;
      modalImg.alt = alt || '';
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      resetZoom();
    }

    function closeModal() {
      modal.hidden = true;
      modalImg.src = '';
      document.body.style.overflow = '';
      resetZoom();
    }

    if (modal && modalContent) {
      modal.querySelector('.bsc-modal__backdrop').addEventListener('click', closeModal);
      modal.querySelector('.bsc-modal__close').addEventListener('click', closeModal);
      document.addEventListener('keydown', e => { if (e.key === 'Escape' && !modal.hidden) closeModal(); });

      /* ── Mouse wheel zoom ── */
      modalContent.addEventListener('wheel', e => {
        e.preventDefault();
        const rect = modalContent.getBoundingClientRect();
        const mx = e.clientX - rect.left - rect.width  / 2;
        const my = e.clientY - rect.top  - rect.height / 2;
        zoomAt(mx, my, e.deltaY < 0 ? 1.12 : 1 / 1.12);
      }, { passive: false });

      /* ── Mouse pan ── */
      modalContent.addEventListener('mousedown', e => {
        if (e.button !== 0 || zScale <= 1) return;
        isDragging = true;
        dragStartX = e.clientX; dragStartY = e.clientY;
        dragOriginX = zX; dragOriginY = zY;
        modalContent.classList.add('is-grabbing');
      });
      window.addEventListener('mousemove', e => {
        if (!isDragging) return;
        zX = dragOriginX + e.clientX - dragStartX;
        zY = dragOriginY + e.clientY - dragStartY;
        applyZoom();
      });
      window.addEventListener('mouseup', () => {
        isDragging = false;
        modalContent.classList.remove('is-grabbing');
      });

      /* ── Double-click to toggle zoom ── */
      modalContent.addEventListener('dblclick', e => {
        const rect = modalContent.getBoundingClientRect();
        const mx = e.clientX - rect.left - rect.width  / 2;
        const my = e.clientY - rect.top  - rect.height / 2;
        if (zScale > 1) { resetZoom(); } else { zoomAt(mx, my, 2.5); }
      });

      /* ── Touch pinch + pan ── */
      modalContent.addEventListener('touchstart', e => {
        if (e.touches.length === 2) {
          e.preventDefault();
          const t = e.touches;
          pinchStartDist  = Math.hypot(t[0].clientX - t[1].clientX, t[0].clientY - t[1].clientY);
          pinchStartScale = zScale;
        } else if (e.touches.length === 1 && zScale > 1) {
          isDragging  = true;
          dragStartX  = e.touches[0].clientX; dragStartY  = e.touches[0].clientY;
          dragOriginX = zX; dragOriginY = zY;
        }
      }, { passive: false });

      modalContent.addEventListener('touchmove', e => {
        if (e.touches.length === 2) {
          e.preventDefault();
          const t    = e.touches;
          const dist = Math.hypot(t[0].clientX - t[1].clientX, t[0].clientY - t[1].clientY);
          const rect = modalContent.getBoundingClientRect();
          const mx   = (t[0].clientX + t[1].clientX) / 2 - rect.left - rect.width  / 2;
          const my   = (t[0].clientY + t[1].clientY) / 2 - rect.top  - rect.height / 2;
          const newScale = clampZoom(pinchStartScale * dist / pinchStartDist);
          const ratio    = newScale / zScale;
          zX = mx - ratio * (mx - zX);
          zY = my - ratio * (my - zY);
          zScale = newScale;
          applyZoom();
        } else if (e.touches.length === 1 && isDragging) {
          e.preventDefault();
          zX = dragOriginX + e.touches[0].clientX - dragStartX;
          zY = dragOriginY + e.touches[0].clientY - dragStartY;
          applyZoom();
        }
      }, { passive: false });

      modalContent.addEventListener('touchend', () => {
        isDragging = false;
        if (zScale < 1.05) resetZoom();
      });
    }

    document.querySelectorAll('#bsc-carousel-{{ section.id }} .bsc-expand-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const img = btn.closest('.bsc-card__image').querySelector('img');
        if (img && img.src) openModal(img.src, img.alt);
      });
    });
  })();
</script>

