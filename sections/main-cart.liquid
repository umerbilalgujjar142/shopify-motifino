<style>
  .bb-trust-banner {
    display: flex;
    align-items: stretch;
    background: #f4f4f4;
    border-radius: 10px;
    padding: 8px 4px;
    /* Capped so it keeps its phone size on a wide screen instead of stretching. */
    width: 100%;
    max-width: 400px;
    margin-inline: auto;
    margin-block-end: 14px;
  }

  .bb-trust-banner__item {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 2px 10px;
    font-size: 14px;
    line-height: 1.3;
    text-align: center;
  }

  .bb-trust-banner__item + .bb-trust-banner__item {
    border-inline-start: 1px solid rgba(0, 0, 0, 0.12);
  }

  /* Fixed at every width — the desktop type scale must not grow it. */
  .bb-trust-banner__item svg {
    flex-shrink: 0;
    width: 16px;
    height: auto;
  }

  /* Both sides of the delivery box end up at 8px: no padding under the last row,
     and the wrapper gap below matches the recap's own gap. */
  #shopify-section-{{ section.id }} .order-summary__body tr:last-child td { padding-block-end: 0; }

  .bb-eta {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #f4f4f4;
    border-radius: 10px;
    padding: 12px 16px;
    font-size: 14px;
    line-height: 1.3;
    margin: 20px 0 5px;
  }

  .bb-eta svg {
    flex-shrink: 0;
    width: 22px;
    height: auto;
  }

  .line-item__quantity { margin-block-start: 0.2rem; }
  body.bb-cart-busy .line-item__quantity { pointer-events: none; opacity: 0.45; }

  /* The control that was clicked spins in place; its line stays undimmed. */
  body.bb-cart-busy .line-item__quantity.bb-qty-active { opacity: 1; }
  .bb-qty-spin { position: relative; }
  .bb-qty-spin > *:not(.bb-qty-spinner) { visibility: hidden; }
  .bb-qty-spinner {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: currentColor;
  }
  .bb-qty-spinner svg { animation: bb-chk-spin 0.7s linear infinite; }

  /* One layout on every screen: price row under the title, stepper under it,
     and no separate total column. */
  #shopify-section-{{ section.id }} .order-summary__header,
  #shopify-section-{{ section.id }} .order-summary__body td:nth-child(n + 2) {
    display: none;
  }

  #shopify-section-{{ section.id }} .line-item { column-gap: 0.4rem; }

  /* The info column must be width-bound, or a long title grows the row instead
     of truncating. */
  #shopify-section-{{ section.id }} .line-item-info {
    flex: 1 1 auto;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} .line-item-info .v-stack,
  #shopify-section-{{ section.id }} .bb-title-actions,
  #shopify-section-{{ section.id }} .bb-li-pricerow {
    width: 100%;
    min-width: 0;
  }

  /* The discount badge takes the far right of the price row at every width. */
  #shopify-section-{{ section.id }} .bb-li-discount.discount-badge {
    margin-inline-start: auto;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .order-summary .line-item-info {
      max-width: none;
    }
  }

  /* Mobile only: the length is pinned right so it lines up down the column,
     whether the name truncated or not. */
  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .bb-li-title__variant {
      margin-inline-start: auto;
    }
  }

  .bb-privilege-remove-btn {
    width: 3.4rem;
    height: 3.4rem;
    display: grid;
    place-items: center;
    border: 1px solid rgb(var(--border-color));
    background: transparent;
    color: rgb(var(--text-color) / 0.6);
    cursor: pointer;
    padding: 0;
  }
  .bb-privilege-remove-btn:hover { color: rgb(var(--text-color)); }
  .bb-privilege-remove-btn:disabled { opacity: 0.35; cursor: default; }

  @media screen and (min-width: 990px) {
    .cart-footer {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      gap: 2rem;
    }
    .cart-footer .cart-note {
      flex: 1;
    }
    .cart-footer .bb-cart-recap {
      min-width: 360px;
      max-width: 400px;
      flex-shrink: 0;
      margin-left: auto;
    }
  }
</style>

{%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient
  | default: section.settings.color_scheme.settings.background
  | md5
-%}

{%- if section.settings.use_custom_section_spacing -%}
  <style>
    #shopify-section-{{ section.id }} .section-spacing.section-spacing--custom-bbox {
      padding-block-start: var(--main-cart-bbox-pt);
      padding-inline-end: var(--main-cart-bbox-pr);
      padding-block-end: var(--main-cart-bbox-pb);
      padding-inline-start: var(--main-cart-bbox-pl);
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .section-spacing.section-spacing--custom-bbox {
        padding-block-start: var(--main-cart-bbox-pt-d);
        padding-inline-end: var(--main-cart-bbox-pr-d);
        padding-block-end: var(--main-cart-bbox-pb-d);
        padding-inline-start: var(--main-cart-bbox-pl-d);
      }
    }

    #shopify-section-{{ section.id }} .section-spacing.section-spacing--custom-bbox .container {
      margin-inline-start: max(0px, 50% - var(--container-max-width) / 2);
      margin-inline-end: max(0px, 50% - var(--container-max-width) / 2);
    }
  </style>
{%- endif -%}

<div
  class="section-spacing{% if section.settings.use_custom_section_spacing %} section-spacing--custom-bbox{% else %} section-spacing--tight{% endif %} color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }}"
  {% if section.settings.use_custom_section_spacing %}
    style="--main-cart-bbox-pt: {{ section.settings.mobile_section_spacing_top | default: 0 }}px; --main-cart-bbox-pr: {{ section.settings.mobile_section_spacing_right | default: 0 }}px; --main-cart-bbox-pb: {{ section.settings.mobile_section_spacing_bottom | default: 0 }}px; --main-cart-bbox-pl: {{ section.settings.mobile_section_spacing_left | default: 0 }}px; --main-cart-bbox-pt-d: {{ section.settings.desktop_section_spacing_top | default: 0 }}px; --main-cart-bbox-pr-d: {{ section.settings.desktop_section_spacing_right | default: 0 }}px; --main-cart-bbox-pb-d: {{ section.settings.desktop_section_spacing_bottom | default: 0 }}px; --main-cart-bbox-pl-d: {{ section.settings.desktop_section_spacing_left | default: 0 }}px;"
  {% endif %}
>
  {%- if cart.empty? -%}
    <div class="container container--xs">
      <div class="empty-state">
        <div class="prose">
          <h1 class="h4">{{ 'cart.general.title' | t }}</h1>
          <p>{{ 'cart.general.empty' | t }}</p>

          {%- assign button_content = 'cart.general.continue_shopping' | t -%}
          {%- render 'button', content: button_content, href: settings.cart_empty_cart_link -%}
        </div>
      </div>
    </div>
  {%- else -%}
    <div class="container container--sm">
      <div class="section-stack">
        {%- comment -%}
          One belt = one unit of a "Combinazione cintura" product (belt + buckle already
          combined). Quantities count, so two units of the same combination are two belts —
          two boxes, two privilege cards.
        {%- endcomment -%}
        {%- assign _cart_belt_count = 0 -%}
        {%- assign _cart_card_count = 0 -%}
        {%- for _ci in cart.items -%}
          {%- if _ci.product.type == 'Combinazione cintura' -%}
            {%- assign _cart_belt_count = _cart_belt_count | plus: _ci.quantity -%}
          {%- endif -%}
          {%- if _ci.product.handle == 'privilege-card-black' -%}
            {%- assign _cart_card_count = _cart_card_count | plus: _ci.quantity -%}
          {%- endif -%}
        {%- endfor -%}
        <div class="section-header justify-self-center text-center">
          <div class="v-stack gap-1">
            <h1 class="h2">{{ 'cart.general.title' | t }}</h1>

            {%- if settings.cart_show_free_shipping_bar -%}
              {%- render 'free-shipping-bar' -%}
            {%- endif -%}
          </div>
        </div>

        {%- if section.settings.show_trust_banner -%}
          <div class="bb-trust-banner">
            {%- if section.settings.trust_text_1 != blank -%}
              <div class="bb-trust-banner__item">
                {%- render 'icon' with section.settings.trust_icon_1, width: 18 -%}
                <span>{{ section.settings.trust_text_1 }}</span>
              </div>
            {%- endif -%}
            {%- if section.settings.trust_text_2 != blank -%}
              <div class="bb-trust-banner__item">
                {%- render 'icon' with section.settings.trust_icon_2, width: 18 -%}
                <span>{{ section.settings.trust_text_2 }}</span>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <form action="{{ routes.cart_url }}" method="POST" class="cart-page">
          <input type="hidden" name="attributes[products_mobile_grid_mode]" value="">
          <input type="hidden" name="attributes[products_desktop_grid_mode]" value="">

          <div class="v-stack gap-6" style="gap: 8px;">
            {%- comment -%}
              ----------------------------------------------------------------------------------------------------------------
              ORDER SUMMARY
              ----------------------------------------------------------------------------------------------------------------
            {%- endcomment -%}
            <table class="order-summary table--reduce-border">
              <thead class="order-summary__header">
                <tr>
                  <th>{{ 'cart.order.product' | t }}</th>
                  <th class="text-end">{{ 'cart.order.total' | t }}</th>
                </tr>
              </thead>

              <tbody class="order-summary__body">
                {%- comment -%}
                  Every row is a real Shopify line item — the same items the customer
                  sees at checkout. No synthesised belt rows, no hidden component lines.
                {%- endcomment -%}
                {%- comment -%}
                  Two passes so the free Privilege Card always sits under the belts,
                  whatever order Shopify added the lines in.
                {%- endcomment -%}
                {%- for _pass in (1..2) -%}
                {%- for line_item in cart.items -%}
                  {%- assign _is_card = false -%}
                  {%- if line_item.product.handle == 'privilege-card-black' -%}
                    {%- assign _is_card = true -%}
                  {%- endif -%}
                  {%- if _pass == 1 and _is_card -%}{%- continue -%}{%- endif -%}
                  {%- if _pass == 2 and _is_card == false -%}{%- continue -%}{%- endif -%}
                  {%- comment -%}
                    A theme add-to-cart lands here before the card count has caught up.
                    Skip the stale row — the corrected one is drawn after the loop.
                  {%- endcomment -%}
                  {%- if _is_card and _cart_belt_count != _cart_card_count -%}{%- continue -%}{%- endif -%}
                  <tr>
                    <td>
                      {%- render 'line-item', line_item: line_item, show_quantity_selector: true -%}
                    </td>
                    <td class="text-end" style="vertical-align:middle;">
                      {%- if line_item.product.handle == 'privilege-card-black' -%}
                        {{- 0 | money_with_currency -}}
                      {%- else -%}
                        {%- if settings.currency_code_enabled -%}
                          {{- line_item.final_line_price | money_with_currency -}}
                        {%- else -%}
                          {{- line_item.final_line_price | money -}}
                        {%- endif -%}
                        {%- if line_item.original_line_price > line_item.final_line_price -%}
                          <br>
                          <span class="bb-li-original-price">
                            {{- line_item.original_line_price | money -}}
                          </span>
                        {%- endif -%}
                      {%- endif -%}
                    </td>
                  </tr>
                {%- endfor -%}
                {%- endfor -%}

                {%- comment -%}
                  One free card per belt. When the cart arrives out of step the row is
                  drawn from the belt count straight away, and the sync below makes it
                  real — so the customer never watches the number correct itself.
                {%- endcomment -%}
                {%- if _cart_belt_count != _cart_card_count and _cart_belt_count > 0 -%}
                  {%- assign _pc = all_products['privilege-card-black'] -%}
                  {%- assign _pc_value = _cart_belt_count | times: 1999 -%}
                  <tr>
                    <td>
                      <line-item class="line-item">
                        <div class="bb-line-item-img-wrap">
                          {{-
                            _pc.featured_image
                            | image_url: width: 360
                            | image_tag:
                              loading: 'lazy',
                              sizes: '(max-width: 699px) 70px, 120px',
                              widths: '70,120,140,210,240,360',
                              class: 'line-item__media'
                          -}}
                        </div>
                        <div class="line-item-info">
                          <div class="v-stack">
                            <div class="v-stack justify-items-start gap-1">
                              <div class="bb-title-actions">
                                <p style="font-weight:700;margin:0;">
                                  {{- _pc.title }}{% if _cart_belt_count > 1 %} x{{ _cart_belt_count }}{% endif -%}
                                </p>
                              </div>
                            </div>
                            <div class="v-stack justify-items-start gap-1">
                              <div class="h-stack gap-2" style="align-items:center;">
                                <span style="color:#000;font-weight:400;">GRATIS</span>
                                <span style="font-size:13px;color:#c0392b;text-decoration:line-through;">
                                  {{- _pc_value | money -}}
                                </span>
                              </div>
                            </div>
                          </div>
                        </div>
                      </line-item>
                    </td>
                    <td class="text-end" style="vertical-align:middle;">
                      {{- 0 | money_with_currency -}}
                    </td>
                  </tr>
                {%- endif -%}
              </tbody>
            </table>

            {%- comment -%}
              ----------------------------------------------------------------------------------------------------------------
              CART FOOTER
              ----------------------------------------------------------------------------------------------------------------
            {%- endcomment -%}
            <div class="cart-footer">
              {%- if section.settings.show_cart_note -%}
                <cart-note class="cart-note">
                  {%- assign order_note = 'cart.general.add_order_note' | t -%}
                  {%- assign placeholder = 'cart.general.note_placeholder' | t -%}
                  {%- render 'input',
                    name: 'note',
                    multiline: 3,
                    label: order_note,
                    value: cart.note,
                    placeholder: placeholder,
                    show_label_as_block: true
                  -%}
                </cart-note>
              {%- endif -%}

              <div class="bb-cart-recap">
                {%- if section.settings.show_delivery_estimate -%}
                  {%- liquid
                    assign _dw = ''
                    if section.settings.delivery_work_sun
                      assign _dw = _dw | append: '0,'
                    endif
                    if section.settings.delivery_work_mon
                      assign _dw = _dw | append: '1,'
                    endif
                    if section.settings.delivery_work_tue
                      assign _dw = _dw | append: '2,'
                    endif
                    if section.settings.delivery_work_wed
                      assign _dw = _dw | append: '3,'
                    endif
                    if section.settings.delivery_work_thu
                      assign _dw = _dw | append: '4,'
                    endif
                    if section.settings.delivery_work_fri
                      assign _dw = _dw | append: '5,'
                    endif
                    if section.settings.delivery_work_sat
                      assign _dw = _dw | append: '6,'
                    endif

                    assign _hol = section.settings.delivery_holidays | default: ''

                    # Anchored at midday so whole-day steps never trip over a DST change.
                    assign _today = 'now' | date: '%Y-%m-%d'
                    assign _start = _today | append: ' 12:00:00' | date: '%s' | plus: 0

                    assign _nh = 'now' | date: '%H'
                    assign _nm = 'now' | date: '%M'
                    assign _now_mins = _nh | times: 60 | plus: _nm
                    assign _cut_mins = section.settings.delivery_cutoff_hour | times: 60 | plus: section.settings.delivery_cutoff_minute
                    if _now_mins >= _cut_mins
                      assign _start = _start | plus: 86400
                    endif

                    for i in (1..21)
                      assign _dow = _start | date: '%w'
                      assign _ymd = _start | date: '%Y-%m-%d'
                      assign _ok = false
                      if _dw contains _dow
                        assign _ok = true
                      endif
                      if _hol contains _ymd
                        assign _ok = false
                      endif
                      if _ok
                        break
                      endif
                      assign _start = _start | plus: 86400
                    endfor

                    assign _min_add = section.settings.delivery_ready_min | plus: section.settings.delivery_days_min
                    assign _max_add = section.settings.delivery_ready_max | plus: section.settings.delivery_days_max
                    if _max_add < _min_add
                      assign _max_add = _min_add
                    endif

                    assign _cur = _start
                    assign _added = 0
                    for i in (1..180)
                      if _added >= _min_add
                        break
                      endif
                      assign _cur = _cur | plus: 86400
                      assign _dow = _cur | date: '%w'
                      assign _ymd = _cur | date: '%Y-%m-%d'
                      if _dw contains _dow
                        unless _hol contains _ymd
                          assign _added = _added | plus: 1
                        endunless
                      endif
                    endfor
                    assign _eta_from = _cur

                    for i in (1..180)
                      if _added >= _max_add
                        break
                      endif
                      assign _cur = _cur | plus: 86400
                      assign _dow = _cur | date: '%w'
                      assign _ymd = _cur | date: '%Y-%m-%d'
                      if _dw contains _dow
                        unless _hol contains _ymd
                          assign _added = _added | plus: 1
                        endunless
                      endif
                    endfor
                    assign _eta_to = _cur

                    assign _wnames = 'Dom,Lun,Mar,Mer,Gio,Ven,Sab' | split: ','
                    assign _i1 = _eta_from | date: '%w' | plus: 0
                    assign _i2 = _eta_to | date: '%w' | plus: 0
                    assign _d1 = _eta_from | date: '%-d'
                    assign _d2 = _eta_to | date: '%-d'
                    assign _label_from = _wnames[_i1] | append: ' ' | append: _d1
                    assign _label_to = _wnames[_i2] | append: ' ' | append: _d2
                  -%}
                  <div class="bb-eta">
                    {%- if section.settings.show_delivery_icon -%}
                      {%- render 'icon' with section.settings.delivery_icon, width: 22 -%}
                    {%- endif -%}
                    <span>
                      {{ section.settings.delivery_text }}
                      <strong>{{ _label_from }}</strong>
                      {%- if _eta_to > _eta_from %} - <strong>{{ _label_to }}</strong>{% endif -%}
                    </span>
                  </div>
                {%- endif -%}

                {%- render 'cart-discount' -%}

                {%- if cart.cart_level_discount_applications.size > 0 -%}
                  <div class="bb-recap-coupons">
                    {%- for discount_application in cart.cart_level_discount_applications -%}
                      <span class="discount-badge text-xs">
                        {%- render 'icon' with 'discount', width: 12 -%}
                        {{- discount_application.title -}}
                        (-{{ discount_application.total_allocated_amount | money }})
                        {%- if section.settings.allow_discount_application and discount_application.type != '' -%}
                          <cart-discount-remove-button
                            discount-code="{{ discount_application.title | escape }}"
                            class="h-stack align-center"
                          >
                            <button type="button">{%- render 'icon' with 'close', width: 8 -%}</button>
                          </cart-discount-remove-button>
                        {%- endif -%}
                      </span>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                {%- comment -%}
                  Totals come straight from Shopify, so the recap can never disagree with
                  what is charged at checkout.
                    original_total_price  — before any discount
                    items_subtotal_price  — after line-level discounts (the set offer)
                    total_price           — after cart-level discounts too (coupon codes)
                {%- endcomment -%}
                {%- assign _bb_offerta_total = cart.original_total_price | minus: cart.items_subtotal_price -%}
                {%- assign _shipping_threshold_cents = settings.cart_free_shipping_threshold | times: 100 -%}

                <div class="bb-recap-row">
                  <span>Importo:</span>
                  <span>
                    {%- if _bb_offerta_total > 0 -%}
                      <span class="bb-li-original-price">{{ cart.original_total_price | money }}</span>
                      <span class="bb-recap-off">(-{{ _bb_offerta_total | money }})</span>
                    {%- else -%}
                      {{ cart.original_total_price | money }}
                    {%- endif -%}
                  </span>
                </div>

                {%- if cart.total_price >= _shipping_threshold_cents -%}
                  <div class="bb-recap-row">
                    <span>Spedizione:</span>
                    <span>Gratis</span>
                  </div>
                {%- endif -%}

                {%- for block in section.blocks -%}
                  {%- if block.type == '@app' -%}{%- render block -%}{%- endif -%}
                {%- endfor -%}

                <div class="bb-recap-row bb-recap-row--total">
                  <span>{{ 'cart.general.total' | t }}:</span>
                  <span>{{ cart.total_price | money_with_currency }}</span>
                </div>

                {%- if section.settings.show_accelerated_buttons and additional_checkout_buttons -%}
                  <div class="additional-checkout-buttons additional-checkout-buttons--vertical">
                    {{- content_for_additional_checkout_buttons -}}
                  </div>
                {%- endif -%}

                <noscript>
                  {%- assign update_button = 'cart.general.update_cart' | t -%}
                  {%- render 'button', type: 'submit', content: update_button, style: 'outline' -%}
                </noscript>

                <button type="submit" name="checkout" class="bb-checkout-btn">
                  {{ 'cart.general.checkout' | t }}
                </button>

                {%- if section.settings.show_help_link and section.settings.help_link_text != blank -%}
                  {%- assign _help_size = section.settings.help_link_size | default: 14 -%}
                  {%- if section.settings.help_link != blank -%}
                    <a class="bb-cart-help-link" style="font-size:{{ _help_size }}px" href="{{ section.settings.help_link }}">
                      {{- section.settings.help_link_text -}}
                    </a>
                  {%- else -%}
                    <span class="bb-cart-help-link" style="font-size:{{ _help_size }}px">
                      {{- section.settings.help_link_text -}}
                    </span>
                  {%- endif -%}
                {%- endif -%}

                {%- if shop.enabled_payment_types.size > 0 -%}
                  <ul class="payment-methods unstyled-list bb-cart-payment-icons">
                    {%- for type in shop.enabled_payment_types -%}
                      <li>{{- type | payment_type_svg_tag -}}</li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            </div>
          </div>

          {%- comment -%}
            ----------------------------------------------------------------------------------------------------------------
            SHIPPING ESTIMATOR
            ----------------------------------------------------------------------------------------------------------------
          {%- endcomment -%}

          {%- if section.settings.show_shipping_estimator and cart.requires_shipping -%}
            {%- render 'shipping-estimator' -%}
          {%- endif -%}
        </form>
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  /* Privilege Card (Silver/Gold): standalone gifted product, qty capped at 1 — remove-only control.
     Registered unconditionally (not gated on bundle presence) so it works in a cart with no belts too. */
  (function () {
    /* Our own writes carry this header: belt-combination.js watches every cart
       write and re-syncs (and reloads) the ones it didn't make. */
    var CART_HEADERS = {
      'Content-Type': 'application/json',
      'Accept': 'application/json',
      'X-Motifino-Cart-Sync': '1'
    };

    document.addEventListener('click', function (e) {
      var btn = e.target.closest('.bb-privilege-remove-btn');
      if (!btn) return;
      e.preventDefault();
      btn.disabled = true;
      document.body.classList.add('bb-cart-busy');

      var section = window.MOTIFINO_CART_SECTIONS || '{{ section.id }}';

      fetch('{{ routes.cart_change_url }}.js', {
        method: 'POST',
        headers: CART_HEADERS,
        body: JSON.stringify({ id: btn.dataset.lineKey, quantity: 0, sections: section })
      }).then(function (r) { return r.json(); })
        .then(function (payload) {
          var B = window.MotifinoBelt;
          if (!B || !B.renderSections(payload, section.split(','))) { window.location.reload(); return; }
          document.body.classList.remove('bb-cart-busy');
        })
        .catch(function () {
          btn.disabled = false;
          document.body.classList.remove('bb-cart-busy');
        });
    });
  })();
</script>

