{%- if section.blocks.size > 0 -%}
  {%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

  {%- if section.settings.use_custom_section_spacing -%}
    <style>
      #shopify-section-{{ section.id }} .section-spacing.section-spacing--custom-bbox {
        padding-block-start: var(--tabs-bbox-pt);
        padding-inline-end: var(--tabs-bbox-pr);
        padding-block-end: var(--tabs-bbox-pb);
        padding-inline-start: var(--tabs-bbox-pl);
      }

      @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} .section-spacing.section-spacing--custom-bbox {
          padding-block-start: var(--tabs-bbox-pt-d);
          padding-inline-end: var(--tabs-bbox-pr-d);
          padding-block-end: var(--tabs-bbox-pb-d);
          padding-inline-start: var(--tabs-bbox-pl-d);
        }
      }

      #shopify-section-{{ section.id }} .section-spacing.section-spacing--custom-bbox .container {
        margin-inline-start: max(0px, 50% - var(--container-max-width) / 2);
        margin-inline-end: max(0px, 50% - var(--container-max-width) / 2);
      }
    </style>
  {%- endif -%}

  <div class="section-spacing{% if section.settings.use_custom_section_spacing %} section-spacing--custom-bbox{% endif %} color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}"{% if section.settings.use_custom_section_spacing %} style="--tabs-bbox-pt: {{ section.settings.mobile_section_spacing_top | default: 0 }}px; --tabs-bbox-pr: {{ section.settings.mobile_section_spacing_right | default: 0 }}px; --tabs-bbox-pb: {{ section.settings.mobile_section_spacing_bottom | default: 0 }}px; --tabs-bbox-pl: {{ section.settings.mobile_section_spacing_left | default: 0 }}px; --tabs-bbox-pt-d: {{ section.settings.desktop_section_spacing_top | default: 0 }}px; --tabs-bbox-pr-d: {{ section.settings.desktop_section_spacing_right | default: 0 }}px; --tabs-bbox-pb-d: {{ section.settings.desktop_section_spacing_bottom | default: 0 }}px; --tabs-bbox-pl-d: {{ section.settings.desktop_section_spacing_left | default: 0 }}px;"{% endif %}>
    <div class="container {% if section.settings.text_alignment == 'center' %}container--xl{% endif %}">
      <div class="section-stack">
        {%- render 'section-header',
          subheading: section.settings.subheading,
          heading: section.settings.title,
          content: section.settings.content,
          text_alignment: section.settings.text_alignment
        -%}

        <!-- DESKTOP LAYOUT -->

        <x-tabs class="content-tabs {% if section.settings.text_alignment == 'center' %}content-tabs--center{% endif %} hidden sm:block">
          <template shadowrootmode="open">
            <slot role="tablist" part="tab-list" name="title"></slot>
            <slot part="tab-panel-list" name="content"></slot>
          </template>

          {%- for block in section.blocks -%}
            {%- liquid
              assign title = block.settings.page.title | default: block.settings.title

              if block.type == 'tab'
                assign content = block.settings.page.content | default: block.settings.content
              elsif block.type == 'liquid'
                assign content = block.settings.liquid
              endif
            -%}

            {%- if title != blank and content != blank -%}
              <button class="h6" type="button" role="tab" slot="title" {{ block.shopify_attributes }}>{{ title }}</button>

              <div role="tabpanel" slot="content" {% cycle '', 'hidden', 'hidden', 'hidden', 'hidden' %}>
                <div class="prose">
                  {{- content -}}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </x-tabs>

        <!-- MOBILE LAYOUT -->

        <div
          class="accordion-group sm:hidden"
          data-auto-close="{% if section.settings.enable_auto_close %}true{% else %}false{% endif %}"
        >
          {%- for block in section.blocks -%}
            {%- liquid
              assign title = block.settings.page.title | default: block.settings.title

              if block.type == 'tab'
                assign content = block.settings.page.content | default: block.settings.content
              elsif block.type == 'liquid'
                assign content = block.settings.liquid
              endif
            -%}

            {%- if title != blank and content != blank -%}
              {%- render 'accordion', title: title, content: content, open: block.settings.open_on_mobile, prose_content: true -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  {%- if section.settings.enable_auto_close -%}
    <script>
      (function () {
        var sectionEl = document.querySelector('#shopify-section-{{ section.id }}');
        if (!sectionEl) return;

        var wrapper = sectionEl.querySelector('.accordion-group[data-auto-close="true"]');
        if (!wrapper) return;

        var mobileQuery = window.matchMedia('(max-width: 699px)');

        function getScrollOffset() {
          var raw = getComputedStyle(document.documentElement).getPropertyValue('--sticky-area-height').trim();
          var n = parseFloat(raw);
          return (Number.isFinite(n) ? n : 0) + 120;
        }

        wrapper.addEventListener(
          'click',
          function (e) {
            if (!mobileQuery.matches) return;

            var summary = e.target.closest('summary');
            if (!summary || !wrapper.contains(summary)) return;

            var details = summary.closest('details');
            var host = summary.closest('accordion-disclosure');
            if (!details || !host) return;

            if (details.hasAttribute('open')) {
              return;
            }

            wrapper.querySelectorAll('accordion-disclosure').forEach(function (acc) {
              if (acc === host) return;
              var d = acc.querySelector('details');
              if (d && d.hasAttribute('open') && typeof acc.toggle === 'function') {
                acc.toggle(false);
              }
            });

            setTimeout(function () {
              var headerOffset = getScrollOffset();
              var top = host.getBoundingClientRect().top + window.scrollY - headerOffset;
              window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
            }, 150);
          },
          true
        );
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.tabs.name",
  "class": "shopify-section--tabs",
  "max_blocks": 5,
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_custom_section_spacing",
      "label": "Use custom section spacing",
      "default": false
    },
    {
      "type": "header",
      "content": "Mobile section spacing",
      "info": "Requires 'Use custom section spacing' to be checked",
      "visible_if": "{{ section.settings.use_custom_section_spacing }}"
    },
    {
      "type": "range",
      "id": "mobile_section_spacing_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Requires 'Use custom section spacing' to be checked",
      "visible_if": "{{ section.settings.use_custom_section_spacing }}"
    },
    {
      "type": "range",
      "id": "mobile_section_spacing_right",
      "label": "Padding right",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Requires 'Use custom section spacing' to be checked",
      "visible_if": "{{ section.settings.use_custom_section_spacing }}"
    },
    {
      "type": "range",
      "id": "mobile_section_spacing_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Requires 'Use custom section spacing' to be checked",
      "visible_if": "{{ section.settings.use_custom_section_spacing }}"
    },
    {
      "type": "range",
      "id": "mobile_section_spacing_left",
      "label": "Padding left",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Requires 'Use custom section spacing' to be checked",
      "visible_if": "{{ section.settings.use_custom_section_spacing }}"
    },
    {
      "type": "header",
      "content": "Desktop section spacing",
      "info": "Requires 'Use custom section spacing' to be checked",
      "visible_if": "{{ section.settings.use_custom_section_spacing }}"
    },
    {
      "type": "range",
      "id": "desktop_section_spacing_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Requires 'Use custom section spacing' to be checked",
      "visible_if": "{{ section.settings.use_custom_section_spacing }}"
    },
    {
      "type": "range",
      "id": "desktop_section_spacing_right",
      "label": "Padding right",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Requires 'Use custom section spacing' to be checked",
      "visible_if": "{{ section.settings.use_custom_section_spacing }}"
    },
    {
      "type": "range",
      "id": "desktop_section_spacing_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Requires 'Use custom section spacing' to be checked",
      "visible_if": "{{ section.settings.use_custom_section_spacing }}"
    },
    {
      "type": "range",
      "id": "desktop_section_spacing_left",
      "label": "Padding left",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Requires 'Use custom section spacing' to be checked",
      "visible_if": "{{ section.settings.use_custom_section_spacing }}"
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading",
      "default": "Subheading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "Heading"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:global.text.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:global.position.left"
        },
        {
          "value": "center",
          "label": "t:global.position.center"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "enable_auto_close",
      "label": "Auto-close other tabs (Mobile)",
      "info": "When enabled, opening a tab will automatically close others and realign the screen.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "t:sections.tabs.blocks.tab.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:global.text.title",
          "default": "Tab"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:global.text.content",
          "default": "<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "t:sections.tabs.blocks.tab.page",
          "info": "t:sections.tabs.blocks.tab.page_info"
        },
        {
          "type": "checkbox",
          "id": "open_on_mobile",
          "label": "t:sections.tabs.blocks.tab.open_on_mobile",
          "info": "t:sections.tabs.blocks.tab.open_on_mobile_info",
          "default": false
        }
      ]
    },
    {
      "type": "liquid",
      "name": "t:sections.tabs.blocks.liquid.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:global.text.title",
          "default": "Tab"
        },
        {
          "type": "liquid",
          "id": "liquid",
          "label": "t:global.code.liquid",
          "default": "<p>Use Liquid code to create advanced customization.</p>"
        },
        {
          "type": "checkbox",
          "id": "open_on_mobile",
          "label": "t:sections.tabs.blocks.tab.open_on_mobile",
          "info": "t:sections.tabs.blocks.tab.open_on_mobile_info",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.tabs.presets.tab.name",
      "category": "t:global.categories.content",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "title": "Tab 1",
            "content": "<p>Use this text to share information about your brand with your customers.</p>"
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Tab 2",
            "content": "<p>Describe a product, share announcements, or welcome customers to your store.</p>"
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Tab 3",
            "content": "<p>Share information about your shipping rates, return policy or contact information.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
