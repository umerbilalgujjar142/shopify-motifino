{%- if section.blocks.size > 0 -%}
  {%- liquid
    assign _mobile_spacing = section.settings.mobile_spacing | default: section.settings.spacing | default: 'md'
    assign _desktop_spacing = section.settings.desktop_spacing | default: section.settings.spacing | default: 'md'

    assign mobile_gap = '0rem'
    if _mobile_spacing == 'xs'
      assign mobile_gap = '0.5rem'
    elsif _mobile_spacing == 'sm'
      assign mobile_gap = '1rem'
    elsif _mobile_spacing == 'md'
      assign mobile_gap = '1.5rem'
    elsif _mobile_spacing == 'lg'
      assign mobile_gap = '2rem'
    endif

    assign desktop_gap = '0rem'
    if _desktop_spacing == 'xs'
      assign desktop_gap = '0.09rem'
    elsif _desktop_spacing == 'sm'
      assign desktop_gap = '1.25rem'
    elsif _desktop_spacing == 'md'
      assign desktop_gap = '1.875rem'
    elsif _desktop_spacing == 'lg'
      assign desktop_gap = '2.5rem'
    endif

    assign mg_has_text_parallax = false
    for block in section.blocks
      if block.settings.enable_text_parallax
        assign mg_has_text_parallax = true
      endif
    endfor
  -%}

  {%- if section.settings.section_hide_on_mobile or section.settings.section_hide_on_desktop -%}
    <style>
      {%- if section.settings.section_hide_on_mobile -%}
        @media screen and (max-width: 699px) {
          #shopify-section-{{ section.id }} {
            display: none !important;
          }
        }
      {%- endif -%}

      {%- if section.settings.section_hide_on_desktop -%}
        @media screen and (min-width: 700px) {
          #shopify-section-{{ section.id }} {
            display: none !important;
          }
        }
      {%- endif -%}
    </style>
  {%- endif -%}

  {%- if mg_has_text_parallax -%}
    <style>
      #shopify-section-{{ section.id }} .content-over-media--text-parallax {
        overflow: hidden;
      }

      #shopify-section-{{ section.id }} parallax-media-text.prose {
        display: block;
        will-change: transform;
      }

      @media (prefers-reduced-motion: reduce) {
        #shopify-section-{{ section.id }} parallax-media-text.prose {
          transform: none !important;
          will-change: auto;
        }
      }
    </style>
  {%- endif -%}

  <style>
    #shopify-section-{{ section.id }} .media-grid__item {
      position: relative;
    }

    #shopify-section-{{ section.id }} .media-grid-stretched-link {
      position: absolute;
      inset: 0;
      z-index: 1;
      width: 100%;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .content-over-media .prose {
      position: relative;
      z-index: 2;
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .content-over-media .prose > * {
      pointer-events: auto;
    }

    #shopify-section-{{ section.id }} .content-over-media > :is(picture, img, video-media, svg) {
      pointer-events: none;
    }
  </style>

  <style>
    #shopify-section-{{ section.id }} {
      --media-grid-row-height: {{ section.settings.mobile_row_height }}px;
      --media-grid-gap: {{ mobile_gap }};

      {%- if section.settings.section_width == 'full' -%}
        --container-gutter: var(--media-grid-gap);
      {%- endif -%}

      {%- if section.settings.subheading == blank and section.settings.title == blank and section.settings.content == blank and section.settings.section_width == 'full' -%}
        --section-vertical-spacing-override: var(--media-grid-gap);
      {%- endif -%}
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} {
        --media-grid-row-height: {{ section.settings.desktop_row_height }}px;
      }
    }

    @media screen and (min-width: 1150px) {
      #shopify-section-{{ section.id }} {
        --media-grid-gap: {{ desktop_gap }};
      }
    }

    @media screen and (min-width: 1000px) {
      #shopify-section-{{ section.id }} .media-grid {
        border-radius: {{ section.settings.desktop_outer_radius }}px;
        overflow: hidden;
      }
    }
  </style>

  <style>
    #shopify-section-{{ section.id }} .content-over-media--spacing .prose {
      padding-block-start: var(--content-box-padding-top, 0);
      padding-inline-end: var(--content-box-padding-inline-end, 0);
      padding-block-end: var(--content-box-padding-bottom, 0);
      padding-inline-start: var(--content-box-padding-inline-start, 0);
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .content-over-media--spacing .prose {
        padding-block-start: var(--content-box-padding-top-desktop, var(--content-box-padding-top, 0));
        padding-inline-end: var(--content-box-padding-inline-end-desktop, var(--content-box-padding-inline-end, 0));
        padding-block-end: var(--content-box-padding-bottom-desktop, var(--content-box-padding-bottom, 0));
        padding-inline-start: var(--content-box-padding-inline-start-desktop, var(--content-box-padding-inline-start, 0));
      }
    }
  </style>

  {%- if section.settings.use_custom_section_spacing -%}
    <style>
      #shopify-section-{{ section.id }} .section-spacing.section-spacing--custom-bbox {
        padding-block-start: var(--media-grid-bbox-pt);
        padding-inline-end: var(--media-grid-bbox-pr);
        padding-block-end: var(--media-grid-bbox-pb);
        padding-inline-start: var(--media-grid-bbox-pl);
      }

      @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} .section-spacing.section-spacing--custom-bbox {
          padding-block-start: var(--media-grid-bbox-pt-d);
          padding-inline-end: var(--media-grid-bbox-pr-d);
          padding-block-end: var(--media-grid-bbox-pb-d);
          padding-inline-start: var(--media-grid-bbox-pl-d);
        }
      }

      #shopify-section-{{ section.id }} .section-spacing.section-spacing--custom-bbox .container {
        margin-inline-start: max(0px, 50% - var(--container-max-width) / 2);
        margin-inline-end: max(0px, 50% - var(--container-max-width) / 2);
      }
    </style>
  {%- endif -%}

  {%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

  <div class="section-spacing{% if section.settings.use_custom_section_spacing %} section-spacing--custom-bbox{% endif %} color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}"{% if section.settings.allow_transparent_header %} allow-transparent-header{% endif %}{% if section.settings.use_custom_section_spacing %} style="--media-grid-bbox-pt: {{ section.settings.mobile_section_spacing_top | default: 0 }}px; --media-grid-bbox-pr: {{ section.settings.mobile_section_spacing_right | default: 0 }}px; --media-grid-bbox-pb: {{ section.settings.mobile_section_spacing_bottom | default: 0 }}px; --media-grid-bbox-pl: {{ section.settings.mobile_section_spacing_left | default: 0 }}px; --media-grid-bbox-pt-d: {{ section.settings.desktop_section_spacing_top | default: 0 }}px; --media-grid-bbox-pr-d: {{ section.settings.desktop_section_spacing_right | default: 0 }}px; --media-grid-bbox-pb-d: {{ section.settings.desktop_section_spacing_bottom | default: 0 }}px; --media-grid-bbox-pl-d: {{ section.settings.desktop_section_spacing_left | default: 0 }}px;"{% endif %}>
    <div class="container {% unless section.settings.section_width == 'full' %}container--{{ section.settings.section_width }}{% endunless %}">
      <div class="section-stack">
        {%- render 'section-header', subheading: section.settings.subheading, heading: section.settings.title, content: section.settings.content -%}

        <media-grid class="media-grid">
          {%- for block in section.blocks -%}
            {%- liquid
              assign mg_parallax_this_block = false
              if block.settings.enable_text_parallax
                if block.settings.subheading != blank or block.settings.title != blank or block.settings.content != blank or block.settings.link_text != blank
                  assign mg_parallax_this_block = true
                endif
              endif
            -%}
            {%- if block.type == 'image' -%}
              {%- liquid
                assign mg_desktop_fit = block.settings.desktop_image_fit | default: 'cover'
                assign mg_mobile_fit = block.settings.mobile_image_fit | default: 'cover'
              -%}
              <style>
                #media-grid-item-{{ block.id }} .content-over-media {
                  background-color: transparent !important;
                }
                @media screen and (max-width: 999px) {
                  #media-grid-item-{{ block.id }} img {
                    object-fit: {{ mg_mobile_fit }} !important;
                  }
                }
                @media screen and (min-width: 1000px) {
                  #media-grid-item-{{ block.id }} img {
                    object-fit: {{ mg_desktop_fit }} !important;
                  }
                }
              </style>
            {%- endif -%}
            {%- capture block_content -%}
              <div class="content-over-media content-over-media--spacing{% if mg_parallax_this_block %} content-over-media--text-parallax{% endif %} color-scheme color-scheme--{{ block.settings.color_scheme.id }} group" reveal-on-scroll="true" style="--content-over-media-overlay: {{ block.settings.overlay_color.rgb }} / {{ block.settings.overlay_opacity | divided_by: 100.0 }};{% if block.settings.gradient_overlay != blank %} --content-over-media-gradient-overlay: {{ block.settings.gradient_overlay }};{% endif %} --content-box-padding-top: {{ block.settings.mobile_padding_top }}px; --content-box-padding-inline-end: {{ block.settings.mobile_padding_right }}px; --content-box-padding-bottom: {{ block.settings.mobile_padding_bottom }}px; --content-box-padding-inline-start: {{ block.settings.mobile_padding_left }}px; --content-box-padding-top-desktop: {{ block.settings.desktop_padding_top }}px; --content-box-padding-inline-end-desktop: {{ block.settings.desktop_padding_right }}px; --content-box-padding-bottom-desktop: {{ block.settings.desktop_padding_bottom }}px; --content-box-padding-inline-start-desktop: {{ block.settings.desktop_padding_left }}px; --subheading-shadow: {{ block.settings.subheading_shadow | divided_by: 100.0 }}; --heading-shadow: {{ block.settings.heading_shadow | divided_by: 100.0 }}; --content-shadow: {{ block.settings.content_shadow | divided_by: 100.0 }}; --button-shadow: {{ block.settings.button_shadow | divided_by: 100.0 }};">
                {%- if block.type == 'image' -%}
                  {%- if block.settings.image -%}
                    {%- if section.settings.section_width == 'full' -%}
                      {%- capture sizes_attribute -%}(max-width: 699px) 100vw, {{ 100.0 | divided_by: 12.0 | times: block.settings.column_count | round }}vw{%- endcapture -%}
                    {%- else -%}
                      {%- capture sizes_attribute -%}(max-width: 699px) 100vw, {{ 1260.0 | divided_by: 12.0 | times: block.settings.column_count | round }}px{%- endcapture -%}
                    {%- endif -%}

                    {%- liquid
                      assign loading_strategy = nil

                      # As of today, Shopify reset the automatic loading strategy on each section group. This section is often used in the footer group
                      # to show some images on every pages. This allows to ensure that all images are always lazy-loaded when this section is used in the footer.
                      if section.location == 'footer'
                        assign loading_strategy = 'lazy'
                      endif
                    -%}

                    {%- if block.settings.mobile_image != blank -%}
                      {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: loading_strategy, sizes: sizes_attribute, widths: '200,300,400,500,600,700,800,1000,1200,1400,1600', class: 'zoom-image group-hover:zoom sm-max:hidden' -}}
                      {{- block.settings.mobile_image | image_url: width: block.settings.mobile_image.width | image_tag: loading: loading_strategy, sizes: sizes_attribute, widths: '200,300,400,500,600,700,800,1000,1200,1400,1600', class: 'zoom-image group-hover:zoom sm:hidden' -}}
                    {%- else -%}
                      {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: loading_strategy, sizes: sizes_attribute, widths: '200,300,400,500,600,700,800,1000,1200,1400,1600', class: 'zoom-image group-hover:zoom' -}}
                    {%- endif -%}
                  {%- else -%}
                    {%- capture collection_image -%}collection-{% cycle '1', '2', '3', '4' %}{%- endcapture -%}
                    {{- collection_image | placeholder_svg_tag: 'placeholder zoom-image group-hover:zoom' -}}
                  {%- endif -%}
                {%- else -%}
                  {%- if block.settings.video -%}
                    {%- render 'media', media: block.settings.video, autoplay: block.settings.autoplay, loop: true, controls: block.settings.show_controls -%}
                  {%- else -%}
                    {%- capture collection_image -%}collection-{% cycle '1', '2', '3', '4' %}{%- endcapture -%}
                    {{- collection_image | placeholder_svg_tag: 'placeholder zoom-image group-hover:zoom' -}}
                  {%- endif -%}
                {%- endif -%}

                {%- if block.settings.subheading != blank or block.settings.title != blank or block.settings.content != blank or block.settings.link_text != blank -%}
                  {%- if mg_parallax_this_block -%}
                    <parallax-media-text class="prose prose--tight {{ block.settings.text_position }}">
                      {%- if block.settings.subheading != blank -%}
                        <p class="media-grid__shadow-subheading {{ block.settings.subheading_style }}">{{ block.settings.subheading | escape }}</p>
                      {%- endif -%}
                      <p class="media-grid__shadow-heading {{ block.settings.heading_tag }}">{{ block.settings.title }}</p>

                      <div class="media-grid__shadow-content">
                        {{- block.settings.content -}}
                      </div>

                      {%- if block.settings.link_text != blank -%}
                        {%- render 'button', href: block.settings.link_url, content: block.settings.link_text, style: block.settings.link_style -%}
                      {%- endif -%}
                    </parallax-media-text>
                  {%- else -%}
                    <div class="prose prose--tight {{ block.settings.text_position }}">
                      {%- if block.settings.subheading != blank -%}
                        <p class="media-grid__shadow-subheading {{ block.settings.subheading_style }}">{{ block.settings.subheading | escape }}</p>
                      {%- endif -%}
                      <p class="media-grid__shadow-heading {{ block.settings.heading_tag }}">{{ block.settings.title }}</p>

                      <div class="media-grid__shadow-content">
                        {{- block.settings.content -}}
                      </div>

                      {%- if block.settings.link_text != blank -%}
                        {%- render 'button', href: block.settings.link_url, content: block.settings.link_text, style: block.settings.link_style -%}
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- endcapture -%}

            {%- if block.settings.subheading_shadow > 0 or block.settings.heading_shadow > 0 or block.settings.content_shadow > 0 or block.settings.button_shadow > 0 -%}
              <style>
                #shopify-section-{{ section.id }} #media-grid-item-{{ block.id }} .content-over-media .media-grid__shadow-subheading {
                  text-shadow: 0px 4px 15px rgba(0, 0, 0, var(--subheading-shadow));
                }
                #shopify-section-{{ section.id }} #media-grid-item-{{ block.id }} .content-over-media .media-grid__shadow-heading {
                  text-shadow: 0px 4px 15px rgba(0, 0, 0, var(--heading-shadow));
                }
                #shopify-section-{{ section.id }} #media-grid-item-{{ block.id }} .content-over-media .media-grid__shadow-content,
                #shopify-section-{{ section.id }} #media-grid-item-{{ block.id }} .content-over-media .media-grid__shadow-content * {
                  text-shadow: 0px 4px 15px rgba(0, 0, 0, var(--content-shadow));
                }
                #shopify-section-{{ section.id }} #media-grid-item-{{ block.id }} .content-over-media .prose a.button,
                #shopify-section-{{ section.id }} #media-grid-item-{{ block.id }} .content-over-media .prose button.button {
                  box-shadow: 0px 8px 20px rgba(0, 0, 0, var(--button-shadow));
                }
              </style>
            {%- endif -%}

            <div
              id="media-grid-item-{{ block.id }}"
              class="media-grid__item {% if block.settings.add_padding %}media-grid__item--padded{% endif %}{% if block.settings.hide_on_mobile %} sm-max:hidden{% endif %}{% if block.settings.hide_on_desktop %} sm:hidden{% endif %}"
              style="--media-grid-item-column-span: {{ block.settings.column_count }}; --media-grid-item-row-span: {{ block.settings.row_count }}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.block_link != blank -%}
                <a href="{{ block.settings.block_link }}" class="media-grid-stretched-link" aria-hidden="true" tabindex="-1"></a>
              {%- endif -%}
              {{- block_content -}}
            </div>
          {%- endfor -%}
        </media-grid>
      </div>
    </div>
  </div>

  {%- if mg_has_text_parallax -%}
    <script>
      (function () {
        if (window.customElements.get('parallax-media-text')) {
          return;
        }

        var LERP_FACTOR = 0.26;

        function lerp(start, end, factor) {
          return start + (end - start) * factor;
        }

        class ParallaxMediaText extends HTMLElement {
          connectedCallback() {
            if (this._parallaxBound) {
              return;
            }
            this._parallaxBound = true;

            this.prose = this;
            this.rootEl = this.closest('.media-grid__item');
            this.mediaEl = this.closest('.content-over-media');

            if (!this.rootEl || !this.mediaEl) {
              return;
            }

            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
              return;
            }

            this.runway = 0;
            this.currentY = 0;
            this.targetY = 0;
            this.cachedScrollY = 0;
            this.cachedRootRectTop = 0;
            this.rafId = 0;
            this.renderActive = false;
            this.resizeTimer = null;
            this.scrollAttached = false;

            this.onScroll = this.onScroll.bind(this);
            this.onResizeDebounced = this.onResizeDebounced.bind(this);
            this.render = this.render.bind(this);

            this.io = new IntersectionObserver(
              function (entries) {
                for (var i = 0; i < entries.length; i++) {
                  var entry = entries[i];
                  if (entry.isIntersecting) {
                    if (!this.scrollAttached) {
                      this.scrollAttached = true;
                      this.cacheLayout();
                      this.onScroll();
                      this.currentY = -this.runway;
                      window.addEventListener('scroll', this.onScroll, { passive: true });
                      window.addEventListener('resize', this.onResizeDebounced, { passive: true });
                      this.startRenderLoop();
                    }
                  } else {
                    if (this.scrollAttached) {
                      this.scrollAttached = false;
                      window.removeEventListener('scroll', this.onScroll);
                      window.removeEventListener('resize', this.onResizeDebounced);
                      this.stopRenderLoop();
                      this.prose.style.transform = '';
                      this.prose.style.willChange = 'auto';
                    }
                  }
                }
              }.bind(this),
              { root: null, rootMargin: '0px', threshold: [0, 0.01, 0.1, 0.25, 0.5, 1] }
            );

            this.io.observe(this.rootEl);
          }

          disconnectedCallback() {
            this.scrollAttached = false;
            window.removeEventListener('scroll', this.onScroll);
            window.removeEventListener('resize', this.onResizeDebounced);
            this.stopRenderLoop();
            if (this.resizeTimer) {
              clearTimeout(this.resizeTimer);
            }
            if (this.io) {
              this.io.disconnect();
            }
            this._parallaxBound = false;
          }

          cacheLayout() {
            this.prose.style.transform = 'none';
            this.prose.style.willChange = 'transform';

            var runway = 0;
            if (this.prose.offsetParent === this.mediaEl) {
              runway = Math.max(0, this.prose.offsetTop);
            } else {
              var m = this.mediaEl.getBoundingClientRect();
              var p = this.prose.getBoundingClientRect();
              runway = Math.max(0, p.top - m.top);
            }
            this.runway = runway;

            this.cachedScrollY = window.scrollY;
            this.cachedRootRectTop = this.rootEl.getBoundingClientRect().top;
          }

          onResizeDebounced() {
            var self = this;
            clearTimeout(this.resizeTimer);
            this.resizeTimer = setTimeout(function () {
              self.cacheLayout();
              self.onScroll();
            }, 150);
          }

          onScroll() {
            if (this.runway <= 0) {
              this.targetY = 0;
              return;
            }
            var rectTop = this.cachedRootRectTop + (this.cachedScrollY - window.scrollY);
            var vh = window.innerHeight || 1;
            var progress = (vh - rectTop) / vh;
            if (progress < 0) {
              progress = 0;
            } else if (progress > 1) {
              progress = 1;
            }
            this.targetY = -this.runway * (1 - progress);
          }

          startRenderLoop() {
            this.stopRenderLoop();
            this.renderActive = true;
            this.rafId = window.requestAnimationFrame(this.render);
          }

          render() {
            if (!this.renderActive) {
              return;
            }
            this.currentY = lerp(this.currentY, this.targetY, LERP_FACTOR);
            this.prose.style.transform = 'translate3d(0, ' + this.currentY + 'px, 0)';
            this.rafId = window.requestAnimationFrame(this.render);
          }

          stopRenderLoop() {
            this.renderActive = false;
            if (this.rafId) {
              window.cancelAnimationFrame(this.rafId);
              this.rafId = 0;
            }
          }
        }

        window.customElements.define('parallax-media-text', ParallaxMediaText);
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.media_grid.name",
  "class": "shopify-section--media-grid",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "section_hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "section_hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "allow_transparent_header",
      "label": "t:global.section.allow_transparent_header",
      "info": "t:global.section.allow_transparent_header_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": true
    },
    {
      "type": "range",
      "id": "desktop_row_height",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "t:sections.media_grid.desktop_row_height",
      "default": 290
    },
    {
      "type": "range",
      "id": "mobile_row_height",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "t:sections.media_grid.mobile_row_height",
      "default": 180
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:global.sizes.section_width",
      "options": [
        {
          "value": "xs",
          "label": "t:global.sizes.x_small"
        },
        {
          "value": "sm",
          "label": "t:global.sizes.small"
        },
        {
          "value": "md",
          "label": "t:global.sizes.medium"
        },
        {
          "value": "lg",
          "label": "t:global.sizes.large"
        },
        {
          "value": "full",
          "label": "t:global.sizes.full_width"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "mobile_spacing",
      "label": "t:sections.media_grid.mobile_spacing",
      "options": [
        {
          "value": "none",
          "label": "t:global.sizes.none"
        },
        {
          "value": "xs",
          "label": "t:global.sizes.x_small"
        },
        {
          "value": "sm",
          "label": "t:global.sizes.small"
        },
