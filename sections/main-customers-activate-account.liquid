{%- if section.settings.use_custom_section_spacing -%}
  <style>
    #shopify-section-{{ section.id }} .section-spacing.section-spacing--custom-bbox {
      padding-block-start: var(--main-customers-activate-account-bbox-pt);
      padding-inline-end: var(--main-customers-activate-account-bbox-pr);
      padding-block-end: var(--main-customers-activate-account-bbox-pb);
      padding-inline-start: var(--main-customers-activate-account-bbox-pl);
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .section-spacing.section-spacing--custom-bbox {
        padding-block-start: var(--main-customers-activate-account-bbox-pt-d);
        padding-inline-end: var(--main-customers-activate-account-bbox-pr-d);
        padding-block-end: var(--main-customers-activate-account-bbox-pb-d);
        padding-inline-start: var(--main-customers-activate-account-bbox-pl-d);
      }
    }

    #shopify-section-{{ section.id }} .section-spacing.section-spacing--custom-bbox .container {
      margin-inline-start: max(0px, 50% - var(--container-max-width) / 2);
      margin-inline-end: max(0px, 50% - var(--container-max-width) / 2);
    }
  </style>
{%- endif -%}

<div class="section-spacing{% if section.settings.use_custom_section_spacing %} section-spacing--custom-bbox{% endif %}"{% if section.settings.use_custom_section_spacing %} style="--main-customers-activate-account-bbox-pt: {{ section.settings.mobile_section_spacing_top | default: 0 }}px; --main-customers-activate-account-bbox-pr: {{ section.settings.mobile_section_spacing_right | default: 0 }}px; --main-customers-activate-account-bbox-pb: {{ section.settings.mobile_section_spacing_bottom | default: 0 }}px; --main-customers-activate-account-bbox-pl: {{ section.settings.mobile_section_spacing_left | default: 0 }}px; --main-customers-activate-account-bbox-pt-d: {{ section.settings.desktop_section_spacing_top | default: 0 }}px; --main-customers-activate-account-bbox-pr-d: {{ section.settings.desktop_section_spacing_right | default: 0 }}px; --main-customers-activate-account-bbox-pb-d: {{ section.settings.desktop_section_spacing_bottom | default: 0 }}px; --main-customers-activate-account-bbox-pl-d: {{ section.settings.desktop_section_spacing_left | default: 0 }}px;"{% endif %}>
  <div class="container container--xxs">
    <div class="customer-account-box">
      <div class="v-stack gap-6">
        <div class="v-stack gap-4">
          <h1 class="h3">{{ 'customer.activate_account.title' | t }}</h1>
          <p>{{ 'customer.activate_account.instructions' | t }}</p>
        </div>

        {%- form 'activate_customer_password', name: 'activate', class: 'form', id: 'activate-customer-password' -%}
          <div class="fieldset">
            {% liquid
              if form.errors
                assign content = form.errors | default_errors
                render 'banner', status: 'error', content: content
              endif

              assign password_label = 'customer.activate_account.password' | t
              render 'input', type: 'password', name: 'customer[password]', label: password_label, autocomplete: 'new-password'

              assign password_label_confirmation = 'customer.activate_account.password_confirmation' | t
              render 'input', type: 'password', name: 'customer[password_confirmation]', label: password_label_confirmation, autocomplete: 'new-password'

              assign submit_label = 'customer.activate_account.submit' | t
              render 'button', content: submit_label, type: 'submit'

              assign cancel_label = 'customer.activate_account.cancel' | t
              render 'button', content: cancel_label, name: 'decline', type: 'submit', style: 'outline'
            %}
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
