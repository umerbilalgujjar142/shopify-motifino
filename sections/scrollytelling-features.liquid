          "id": "text_alignment",
          "label": "Text Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "range",
          "id": "mobile_text_padding",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "px",
          "label": "Mobile Top Padding",
          "info": "Distance between image and text on mobile",
          "default": 20
        },
        {
          "type": "header",
          "content": "Heading"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Feature Title"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading Size",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" }
          ],
          "default": "h2"
        },
        {
          "type": "range",
          "id": "margin_bottom_heading",
          "min": 0,
          "max": 60,
          "step": 2,
          "unit": "px",
          "label": "Margin Bottom (Heading)",
          "default": 16
        },
        {
          "type": "header",
          "content": "Description"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Add details about this specific feature here.</p>"
        },
        {
          "type": "range",
          "id": "margin_bottom_desc",
          "min": 0,
          "max": 60,
          "step": 2,
          "unit": "px",
          "label": "Margin Bottom (Description)",
          "default": 24
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "btn_label",
          "label": "Button Label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Button Link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button Style",
          "options": [
            { "value": "solid", "label": "Solid" },
            { "value": "outline", "label": "Outline" },
            { "value": "link", "label": "Link" }
          ],
          "default": "solid"
        },
        {
          "type": "range",
          "id": "margin_bottom_btn",
          "min": 0,
          "max": 60,
          "step": 2,
          "unit": "px",
          "label": "Margin Bottom (Button)",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sticky Scrollytelling",
      "blocks": [
        { "type": "feature_slide" },
        { "type": "feature_slide" }
      ]
    }
  ]
}
{% endschema %}