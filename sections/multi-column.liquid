{%- if section.blocks.size > 0 -%}
  <style>
    #shopify-section-{{ section.id }} {
      --multi-column-gap: {% if section.settings.spacing == 'xs' %}1.5rem{% elsif section.settings.spacing == 'sm' %}2.5rem{% elsif section.settings.spacing == 'md' %}3.125rem{% else %}4.375rem{% endif %};
      --multi-column-column-width: {% if section.settings.stack_on_mobile %}100%{% else %}53vw{% endif %};
      --multi-column-grid: {% if section.settings.stack_on_mobile %}auto / repeat(auto-fit, var(--multi-column-column-width)){% else %}auto / auto-flow var(--multi-column-column-width){% endif %};
      --multi-column-content-alignment: safe {{ section.settings.content_alignment }};
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} {
        --multi-column-columns-per-row: 2;
        --multi-column-column-width: {% if section.settings.stack_on_mobile %}calc(100% / var(--multi-column-columns-per-row) - var(--multi-column-gap) * ((var(--multi-column-columns-per-row) - 1) / var(--multi-column-columns-per-row))){% else %}38vw{% endif %};
      }
    }

    @media screen and (min-width: 999px) {
      #shopify-section-{{ section.id }} {
        --multi-column-gap: {% if section.settings.spacing == 'xs' %}1.875rem{% elsif section.settings.spacing == 'sm' %}3.125rem{% elsif section.settings.spacing == 'md' %}4.375rem{% else %}5.625rem{% endif %};
        --multi-column-columns-per-row: {{ section.settings.columns_per_row }};
        --multi-column-column-width: calc(100% / var(--multi-column-columns-per-row) - var(--multi-column-gap) * ((var(--multi-column-columns-per-row) - 1) / var(--multi-column-columns-per-row)));
        --multi-column-grid: auto / repeat(auto-fit, var(--multi-column-column-width));
      }
    }

    {%- comment -%} Carousel only: wider card = less peek of next slide; max-width 998px avoids overriding desktop at 999px+ {%- endcomment -%}
    {%- unless section.settings.stack_on_mobile -%}
      @media screen and (max-width: 998px) {
        #shopify-section-{{ section.id }} {
          --multi-column-column-width: {{ section.settings.mobile_card_width }}vw !important;
        }
      }
    {%- endunless -%}

    #shopify-section-{{ section.id }} .custom-line-clamp {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      overflow: hidden;
      -webkit-line-clamp: var(--max-lines, 2);
    }

    #shopify-section-{{ section.id }} .multi-column__media img {
      max-width: {{ section.settings.image_max_width }}px;
      width: 100%;
      height: auto;
    }

    #shopify-section-{{ section.id }} .multi-column--text-start .multi-column__media img {
      margin-inline: 0;
    }

    #shopify-section-{{ section.id }} .multi-column--text-center .multi-column__media img {
      margin-inline: auto;
      display: block;
    }

    #shopify-section-{{ section.id }} .multi-column--text-end .multi-column__media img {
      margin-inline-start: auto;
      margin-inline-end: 0;
      display: block;
    }
  </style>

  {%- if section.settings.use_custom_section_spacing -%}
    <style>
      #shopify-section-{{ section.id }} .section-spacing.section-spacing--custom-bbox {
        padding-block-start: var(--multi-column-bbox-pt);
        padding-inline-end: var(--multi-column-bbox-pr);
        padding-block-end: var(--multi-column-bbox-pb);
        padding-inline-start: var(--multi-column-bbox-pl);
      }

      @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} .section-spacing.section-spacing--custom-bbox {
          padding-block-start: var(--multi-column-bbox-pt-d);
          padding-inline-end: var(--multi-column-bbox-pr-d);
          padding-block-end: var(--multi-column-bbox-pb-d);
          padding-inline-start: var(--multi-column-bbox-pl-d);
        }
      }

      #shopify-section-{{ section.id }} .section-spacing.section-spacing--custom-bbox .container {
        margin-inline-start: max(0px, 50% - var(--container-max-width) / 2);
        margin-inline-end: max(0px, 50% - var(--container-max-width) / 2);
      }
    </style>
  {%- endif -%}

  {%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}
  {%- assign card_color_scheme_hash = section.settings.card_color_scheme.settings.background_gradient | default: section.settings.card_color_scheme.settings.background | md5 -%}

  <div class="section-spacing{% if section.settings.use_custom_section_spacing %} section-spacing--custom-bbox{% endif %} color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}"{% if section.settings.use_custom_section_spacing %} style="--multi-column-bbox-pt: {{ section.settings.mobile_section_spacing_top | default: 0 }}px; --multi-column-bbox-pr: {{ section.settings.mobile_section_spacing_right | default: 0 }}px; --multi-column-bbox-pb: {{ section.settings.mobile_section_spacing_bottom | default: 0 }}px; --multi-column-bbox-pl: {{ section.settings.mobile_section_spacing_left | default: 0 }}px; --multi-column-bbox-pt-d: {{ section.settings.desktop_section_spacing_top | default: 0 }}px; --multi-column-bbox-pr-d: {{ section.settings.desktop_section_spacing_right | default: 0 }}px; --multi-column-bbox-pb-d: {{ section.settings.desktop_section_spacing_bottom | default: 0 }}px; --multi-column-bbox-pl-d: {{ section.settings.desktop_section_spacing_left | default: 0 }}px;"{% endif %}>
    <div class="container">
      <div class="section-stack">
        {%- render 'section-header',
          subheading: section.settings.subheading,
          heading: section.settings.title,
          content: section.settings.content,
          text_alignment: section.settings.content_alignment
        -%}

        <multi-column class="multi-column multi-column--text-{{ section.settings.text_alignment }} {% unless section.settings.stack_on_mobile %}scroll-area snap-x bleed md:unbleed{% endunless %}">
          {%- for block in section.blocks -%}
            <div
              class="multi-column__item color-scheme color-scheme--{{ section.settings.card_color_scheme.id }} color-scheme--bg-{{ card_color_scheme_hash }} {% if section.settings.overlap_image and block.settings.title != blank %}multi-column__item--overlap{% endif %} snap-center group"
              style="padding: {{ section.settings.card_padding }}px; border-radius: {{ section.settings.card_border_radius }}px;"
              {{ block.shopify_attributes }}
            >
              {%- capture sizes_attribute -%}
                {%- if section.settings.stack_on_mobile -%}
                  (max-width: 699px) 53vw, (max-width: 999px) 38vw, calc((100vw - 3rem * 2) / {{ section.settings.columns_per_row }})
                {%- else -%}
                  (max-width: 998px) {{ section.settings.mobile_card_width }}vw, calc((100vw - 3rem * 2) / {{ section.settings.columns_per_row }})
                {%- endif -%}
              {%- endcapture -%}

              {%- liquid
                capture media_content
                  if block.type == 'image_with_text' and block.settings.image != blank
                    assign loading_strategy = null

                    if forloop.index > 2 or section.location == 'footer'
                      assign loading_strategy = 'lazy'
                    endif

                    echo block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: loading_strategy, sizes: sizes_attribute, widths: '300,400,500,600,800,1000,1200,1400,1600,1800', class: 'zoom-image group-hover:zoom'
                  elsif block.type == 'video_with_text' and block.settings.video != blank
                    if block.settings.autoplay and block.settings.loop
                      assign show_controls = false
                    else
                      assign show_controls = true
                    endif

                    render 'media', media: block.settings.video, autoplay: block.settings.autoplay, loop: block.settings.loop, controls: show_controls, sizes: sizes_attribute, play_button_background: block.settings.play_button_background
                  endif
                endcapture
              -%}

              {%- if media_content != blank -%}
                {% liquid
                  assign add_link = false

                  if block.type == 'video_with_text' and block.settings.autoplay and block.settings.link_url != blank
                    assign add_link = true
                  elsif block.type == 'image_with_text' and block.settings.link_url != blank
                    assign add_link = true
                  endif
                -%}

                {%- if add_link -%}
                  <a href="{{ block.settings.link_url }}" class="multi-column__media overflow-hidden">
                    {{- media_content -}}
                  </a>
                {%- else -%}
                  <div class="multi-column__media overflow-hidden">
                    {{- media_content -}}
                  </div>
                {%- endif -%}
              {%- endif -%}

              {%- if block.settings.title != blank or block.settings.content != blank or block.settings.link_text != blank -%}
                <div class="prose text-{{ section.settings.text_alignment }}">
                  {%- if block.settings.title != blank -%}
                    <p class="{{ block.settings.heading_tag }} custom-line-clamp" style="--max-lines: {{ section.settings.heading_max_lines }};">{{ block.settings.title }}</p>
                  {%- endif -%}

                  {%- if block.settings.content != blank -%}
                    <div class="rte custom-line-clamp" style="--max-lines: {{ section.settings.text_max_lines }};">
                      {{- block.settings.content -}}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.link_text != blank -%}
                    <a href="{{ block.settings.link_url }}" class="link">{{ block.settings.link_text | escape }}</a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </multi-column>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
