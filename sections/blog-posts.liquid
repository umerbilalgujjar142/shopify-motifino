{%- comment -%}
  ------------------------------------------------------------------------------------------------------------------------
  LIQUID
  ------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}
{%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

{%- if section.settings.use_custom_section_spacing -%}
  <style>
    #shopify-section-{{ section.id }} .section-spacing.section-spacing--custom-bbox {
      padding-block-start: var(--blog-posts-bbox-pt);
      padding-inline-end: var(--blog-posts-bbox-pr);
      padding-block-end: var(--blog-posts-bbox-pb);
      padding-inline-start: var(--blog-posts-bbox-pl);
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .section-spacing.section-spacing--custom-bbox {
        padding-block-start: var(--blog-posts-bbox-pt-d);
        padding-inline-end: var(--blog-posts-bbox-pr-d);
        padding-block-end: var(--blog-posts-bbox-pb-d);
        padding-inline-start: var(--blog-posts-bbox-pl-d);
      }
    }

    #shopify-section-{{ section.id }} .section-spacing.section-spacing--custom-bbox .container {
      margin-inline-start: max(0px, 50% - var(--container-max-width) / 2);
      margin-inline-end: max(0px, 50% - var(--container-max-width) / 2);
    }
  </style>
{%- endif -%}

<div class="section-spacing{% if section.settings.use_custom_section_spacing %} section-spacing--custom-bbox{% endif %} color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}"{% if section.settings.use_custom_section_spacing %} style="--blog-posts-bbox-pt: {{ section.settings.mobile_section_spacing_top | default: 0 }}px; --blog-posts-bbox-pr: {{ section.settings.mobile_section_spacing_right | default: 0 }}px; --blog-posts-bbox-pb: {{ section.settings.mobile_section_spacing_bottom | default: 0 }}px; --blog-posts-bbox-pl: {{ section.settings.mobile_section_spacing_left | default: 0 }}px; --blog-posts-bbox-pt-d: {{ section.settings.desktop_section_spacing_top | default: 0 }}px; --blog-posts-bbox-pr-d: {{ section.settings.desktop_section_spacing_right | default: 0 }}px; --blog-posts-bbox-pb-d: {{ section.settings.desktop_section_spacing_bottom | default: 0 }}px; --blog-posts-bbox-pl-d: {{ section.settings.desktop_section_spacing_left | default: 0 }}px;"{% endif %}>
  <div class="container container--lg">
    <div class="section-stack">
      {%- render 'section-header', subheading: section.settings.subheading, heading: section.settings.title, content: section.settings.content, text_alignment: 'center' -%}

      <blog-posts
        class="blog-post-list justify-center {% unless section.settings.stack_on_mobile %}blog-post-list--carousel scroll-area snap-x bleed md:unbleed{% endunless %}"
        {% if settings.stagger_blog_posts_apparition %}
          reveal-on-scroll="true"
        {% endif %}
      >
        {%- capture sizes -%}(max-width: 699px) 95vw, (max-width: 1149px) calc(100vw / 2), calc((80rem - (5rem * ({{ section.settings.blog.articles_count | default: 3 | at_most: 3 }} - 1) / 3){%- endcapture -%}

        {%- for article in section.settings.blog.articles limit: section.settings.posts_count -%}
          {%- render 'blog-post-card',
            article: article,
            blog: section.settings.blog,
            show_category: section.settings.show_category,
            show_date: section.settings.show_date,
            show_excerpt: section.settings.show_excerpt,
            show_read_more: section.settings.show_read_more,
            sizes: sizes,
            position: forloop.index
          -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            {%- render 'blog-post-card', show_category: section.settings.show_category, show_excerpt: section.settings.show_excerpt -%}
          {%- endfor -%}
        {%- endfor -%}
      </blog-posts>

      {%- if section.settings.button_text != blank -%}
        <div class="justify-self-center">
          {%- assign button_link = section.settings.button_link | default: section.settings.blog.url -%}
          {%- render 'button', href: button_link, content: section.settings.button_text -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.blog_posts.name",
  "class": "shopify-section--blog-posts",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "use_custom_section_spacing",
      "label": "Use custom section spacing",
      "default": false
    },
    {
      "type": "header",
      "content": "Mobile section spacing",
      "info": "Requires 'Use custom section spacing' to be checked",
      "visible_if": "{{ section.settings.use_custom_section_spacing }}"
    },
    {
      "type": "range",
      "id": "mobile_section_spacing_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Requires 'Use custom section spacing' to be checked",
      "visible_if": "{{ section.settings.use_custom_section_spacing }}"
    },
    {
      "type": "range",
      "id": "mobile_section_spacing_right",
      "label": "Padding right",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Requires 'Use custom section spacing' to be checked",
      "visible_if": "{{ section.settings.use_custom_section_spacing }}"
    },
    {
      "type": "range",
      "id": "mobile_section_spacing_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Requires 'Use custom section spacing' to be checked",
      "visible_if": "{{ section.settings.use_custom_section_spacing }}"
    },
    {
      "type": "range",
      "id": "mobile_section_spacing_left",
      "label": "Padding left",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Requires 'Use custom section spacing' to be checked",
      "visible_if": "{{ section.settings.use_custom_section_spacing }}"
    },
    {
      "type": "header",
      "content": "Desktop section spacing",
      "info": "Requires 'Use custom section spacing' to be checked",
      "visible_if": "{{ section.settings.use_custom_section_spacing }}"
    },
    {
      "type": "range",
      "id": "desktop_section_spacing_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Requires 'Use custom section spacing' to be checked",
      "visible_if": "{{ section.settings.use_custom_section_spacing }}"
    },
    {
      "type": "range",
      "id": "desktop_section_spacing_right",
      "label": "Padding right",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Requires 'Use custom section spacing' to be checked",
      "visible_if": "{{ section.settings.use_custom_section_spacing }}"
    },
    {
      "type": "range",
      "id": "desktop_section_spacing_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Requires 'Use custom section spacing' to be checked",
      "visible_if": "{{ section.settings.use_custom_section_spacing }}"
    },
    {
      "type": "range",
      "id": "desktop_section_spacing_left",
      "label": "Padding left",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Requires 'Use custom section spacing' to be checked",
      "visible_if": "{{ section.settings.use_custom_section_spacing }}"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.blog_posts.blocks.blog.blog"
    },
    {
      "type": "range",
      "id": "posts_count",
      "min": 2,
      "max": 9,
      "label": "t:sections.blog_posts.blocks.blog.posts_count",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "t:sections.blog_posts.stack_on_mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "t:global.blog.show_category",
      "info": "t:global.blog.show_category_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:global.blog.show_date",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:global.blog.show_excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_read_more",
      "label": "t:global.blog.show_read_more",
      "default": true
    },
    {
      "type": "header",
      "content": "t:global.section.header_category"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "Blog posts"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:global.text.content"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:global.text.button_link",
      "info": "t:sections.blog_posts.button_link_info"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:global.text.button_text",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "t:sections.blog_posts.presets.blog_posts.name",
      "category": "t:global.categories.content",
      "settings": {
        "blog": "news"
      }
    }
  ]
}
{% endschema %}
