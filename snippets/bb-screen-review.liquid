{{ 'bb-screen-review.css' | asset_url | stylesheet_tag }}

{%- comment -%} ══ SCREEN 2: BUNDLE REVIEW ════════════════════== {%- endcomment -%}
<section id="bb-screen-review" class="bb-screen" style="display:none" aria-label="Riepilogo bundle">
  <div class="bb-header">
    {% comment %}
    <button class="bb-btn-icon" data-action="review-back" aria-label="Indietro">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M15 18l-6-6 6-6"/>
      </svg>
    </button>
    {% endcomment %}
    <div class="bb-header__title" id="bb-review-title">Riepilogo Set Doppio</div>
    <div style="width:36px;"></div>
  </div>

  <div
    class="bb-progress"
    id="bb-progress-review"
    style="padding-top:14px;display:flex;align-items:center;justify-content:center;gap:6px;padding-left:16px;padding-right:16px;"
  >
    {%- comment -%} Could also be rendered by JS if desired {%- endcomment -%}
  </div>

  <div class="bb-review__scroll-area">
    <div class="bb-review bb-mt-16" id="bb-review-belts">
      {%- comment -%} Rendered by JS {%- endcomment -%}
    </div>

    <div id="bb-review-add-btn" style="padding:0 16px 14px;"></div>
  </div>

  <div class="bb-review__sticky-footer">
    {% comment %} <div class="bb-divider" style="margin:0 16px;"></div> {% endcomment %}
    <div>
      <div style="display:flex;justify-content:space-between;padding:14px 16px 0;font-size:15px;font-weight:700;">
        <span>Totale pacchetto</span>
        <span id="bb-review-total">€ —</span>
      </div>
      <div style="display:flex;justify-content:space-between;padding:0px 16px 0;font-size:13px;font-weight:700;color:#a9a3a3;">
        <span>Spedizione</span>
        <span id="bb-review-shipping">Gratuita</span>
      </div>
    </div>

    <div class="bb-cta-bar">
      <button class="bb-btn-primary is-accent" data-action="add-to-cart">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        Aggiungi al carrello
      </button>
    </div>
  </div>
</section>
