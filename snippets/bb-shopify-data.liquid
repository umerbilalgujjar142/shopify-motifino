{%- comment -%}
  Builds window.BB_DATA from the "Combinazione cintura" collection passed as combos_collection.
  Each product supplies its strap and buckle (metafields), the preview photo (1st image),
  the worn photo (2nd image) and the cart variants. Carousel order is the collection order:
  the first product to use a strap or buckle fixes its position.
{%- endcomment -%}

<script>
  window.BB_DATA = (function () {
    var straps = {}, strapImages = {}, strapOrder = [];
    var buckles = {}, buckleImages = {}, buckleOrder = [];
    var combos = {};

    function addStrap(k, name, hex, img) {
      if (straps[k]) return;
      straps[k] = { name: name, hex: hex };
      strapImages[k] = { "130": img, "150": img };
      strapOrder.push(k);
    }
    function addBuckle(k, name, img) {
      if (buckles[k]) return;
      buckles[k] = { name: name, image: img };
      buckleImages[k] = img;
      buckleOrder.push(k);
    }

    {%- for p in combos_collection.products -%}
      {%- assign c_strap = p.metafields.custom.strap.value -%}
      {%- assign c_buckle = p.metafields.custom.buckle.value -%}
      {%- if c_strap != blank and c_buckle != blank -%}
        {%- liquid
          assign c_photo = ''
          assign c_worn = ''
          if p.images.size > 0
            assign c_photo = p.images[0] | image_url: width: 1400
          endif
          if p.images.size > 1
            assign c_worn = p.images[1] | image_url: width: 1400
          endif
          assign c_prefix = c_strap.handle | append: '__'
          assign c_suffix = '__b' | append: c_buckle.id

          # A variant reached through a metafield has no .product, so the buckle name
          # comes off the combination title: "Nero - Zeno Gold" -> "Zeno Gold".
          assign c_bname = p.title | split: ' - ' | last | strip
          if c_bname == p.title
            assign c_bname = c_buckle.title
          endif
          assign c_bsrc = c_buckle.metafields.custom.carousel_image.value
          if c_bsrc == blank
            assign c_bsrc = c_buckle.image
          endif
          assign c_bimg = ''
          if c_bsrc
            assign c_bimg = c_bsrc | image_url: width: 600
          endif

          assign c_ssrc = c_strap.metafields.custom.carousel_image.value
          if c_ssrc == blank
            assign c_ssrc = c_strap.featured_image
          endif
          assign c_simg = ''
          if c_ssrc
            assign c_simg = c_ssrc | image_url: width: 900
          endif
          capture c_shex
            echo c_strap.metafields.custom.swatch_colour.value | default: '#888888'
          endcapture
        -%}
        addStrap({{ c_strap.handle | json }}, {{ c_strap.title | json }}, {{ c_shex | strip | json }}, {{ c_simg | json }});
        addBuckle({{ '' | append: 'b' | append: c_buckle.id | json }}, {{ c_bname | json }}, {{ c_bimg | json }});
        {%- for v in p.variants -%}
          {%- assign v_len = v.title | remove: 'cm' | remove: 'CM' | remove: 'Cm' | remove: ' ' | remove: '-' -%}
          combos[{{ c_prefix | append: v_len | append: c_suffix | json }}] = {
            name: {{ p.title | json }},
            sku: {{ v.sku | json }},
            photo: {{ c_photo | json }},
            worn: {{ c_worn | json }},
            image: {{ c_photo | json }},
            handle: {{ p.handle | json }},
            productId: {{ p.id | json }},
            productTitle: {{ p.title | json }},
            variantId: {{ v.id | json }},
            variantTitle: {{ v.title | json }},
            price: {{ v.price | json }},
            available: {{ v.available | json }}
          };
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}

    return {
      straps: straps, strapImages: strapImages, strapOrder: strapOrder,
      buckles: buckles, buckleImages: buckleImages, buckleOrder: buckleOrder,
      combos: combos
    };
  })();
</script>
