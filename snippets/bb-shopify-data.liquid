{%- comment -%}
  Builds window.BB_DATA from Shopify data:
    combos_collection — collection of "Combinazione cintura" products (photo, worn photo, cart variant)
    config_type       — metaobject type holding the two ordered carousel lists
  Emits nothing usable when the data is not set up yet, so bundle-builder.js keeps
  falling back to bundle-builder-media.json.
{%- endcomment -%}

{%- liquid
  assign cfg_type = config_type | default: 'belt_builder_config'
  # .first does not resolve on the values drop, so take the first entry with a loop.
  assign cfg = nil
  for bb_entry in metaobjects[cfg_type].values limit: 1
    assign cfg = bb_entry
  endfor
  if cfg == blank
    for bb_entry in metaobjects.belt_builder_config.values limit: 1
      assign cfg = bb_entry
    endfor
  endif
  # Either field naming works, so the metaobject can be built without fighting key collisions.
  assign bb_straps = cfg.straps.value
  if bb_straps == blank
    assign bb_straps = cfg.strap_list.value
  endif
  assign bb_buckles = cfg.buckles.value
  if bb_buckles == blank
    assign bb_buckles = cfg.buckle_list.value
  endif
-%}

<script>
  window.BB_DATA = (function () {
    var straps = {}, strapImages = {}, strapOrder = [];
    var buckles = {}, buckleImages = {}, buckleOrder = [];
    var combos = {};

    /* Only fill a slot the metaobject did not already provide, so its order still wins. */
    function addStrap(k, name, hex, img) {
      if (straps[k]) return;
      straps[k] = { name: name, hex: hex };
      strapImages[k] = { "130": img, "150": img };
      strapOrder.push(k);
    }
    function addBuckle(k, name, img) {
      if (buckles[k]) return;
      buckles[k] = { name: name, image: img };
      buckleImages[k] = img;
      buckleOrder.push(k);
    }

    {%- for sp in bb_straps -%}
      {%- capture s_hex -%}{{ sp.metafields.custom.swatch_colour.value | default: sp.metafields.custom.swatch_hex.value | default: '#888888' }}{%- endcapture -%}
      {%- liquid
        assign s_src = sp.metafields.custom.carousel_image.value
        if s_src == blank
          assign s_src = sp.metafields.custom.carosuel_image.value
        endif
        if s_src == blank
          assign s_src = sp.featured_image
        endif
        assign s_img = ''
        if s_src
          assign s_img = s_src | image_url: width: 900
        endif
      -%}
      straps[{{ sp.handle | json }}] = { name: {{ sp.title | json }}, hex: {{ s_hex | strip | json }} };
      strapImages[{{ sp.handle | json }}] = { "130": {{ s_img | json }}, "150": {{ s_img | json }} };
      strapOrder.push({{ sp.handle | json }});
    {%- endfor -%}

    {%- for bv in bb_buckles -%}
      {%- liquid
        assign bp = bv.product
        assign b_key = bv.id | prepend: 'b'
        if bp.variants.size > 1
          assign b_name = bp.title | append: ' ' | append: bv.title
        else
          assign b_name = bp.title
        endif
        assign b_src = bv.metafields.custom.carousel_image.value
        if b_src == blank
          assign b_src = bv.metafields.custom.carosuel_image.value
        endif
        if b_src == blank
          assign b_src = bp.metafields.custom.carousel_image.value
        endif
        if b_src == blank
          assign b_src = bp.metafields.custom.carosuel_image.value
        endif
        if b_src == blank
          assign b_src = bv.image | default: bp.featured_image
        endif
        assign b_img = ''
        if b_src
          assign b_img = b_src | image_url: width: 600
        endif
      -%}
      buckles[{{ b_key | json }}] = { name: {{ b_name | json }}, image: {{ b_img | json }} };
      buckleImages[{{ b_key | json }}] = {{ b_img | json }};
      buckleOrder.push({{ b_key | json }});
    {%- endfor -%}

    {%- for p in combos_collection.products -%}
      {%- assign c_strap = p.metafields.custom.strap.value -%}
      {%- assign c_buckle = p.metafields.custom.buckle.value -%}
      {%- if c_strap != blank and c_buckle != blank -%}
        {%- liquid
          assign c_photo = ''
          assign c_worn = ''
          if p.images.size > 0
            assign c_photo = p.images[0] | image_url: width: 1400
          endif
          if p.images.size > 1
            assign c_worn = p.images[1] | image_url: width: 1400
          endif
          assign c_prefix = c_strap.handle | append: '__'
          assign c_suffix = '__b' | append: c_buckle.id
          assign c_bp = c_buckle.product
          if c_bp.variants.size > 1
            assign c_bname = c_bp.title | append: ' ' | append: c_buckle.title
          else
            assign c_bname = c_bp.title
          endif
          assign c_bsrc = c_buckle.metafields.custom.carousel_image.value
          if c_bsrc == blank
            assign c_bsrc = c_bp.metafields.custom.carousel_image.value
          endif
          if c_bsrc == blank
            assign c_bsrc = c_buckle.image | default: c_bp.featured_image
          endif
          assign c_bimg = ''
          if c_bsrc
            assign c_bimg = c_bsrc | image_url: width: 600
          endif
          assign c_ssrc = c_strap.metafields.custom.carousel_image.value
          if c_ssrc == blank
            assign c_ssrc = c_strap.featured_image
          endif
          assign c_simg = ''
          if c_ssrc
            assign c_simg = c_ssrc | image_url: width: 900
          endif
          capture c_shex
            echo c_strap.metafields.custom.swatch_colour.value | default: '#888888'
          endcapture
        -%}
        {%- comment -%} Fallback when the metaobject lists are empty: discover them here. {%- endcomment -%}
        addStrap({{ c_strap.handle | json }}, {{ c_strap.title | json }}, {{ c_shex | strip | json }}, {{ c_simg | json }});
        addBuckle({{ '' | append: 'b' | append: c_buckle.id | json }}, {{ c_bname | json }}, {{ c_bimg | json }});
        {%- for v in p.variants -%}
          {%- assign v_len = v.title | remove: 'cm' | remove: 'CM' | remove: 'Cm' | remove: ' ' | remove: '-' -%}
          combos[{{ c_prefix | append: v_len | append: c_suffix | json }}] = {
            name: {{ p.title | json }},
            sku: {{ v.sku | json }},
            photo: {{ c_photo | json }},
            worn: {{ c_worn | json }},
            image: {{ c_photo | json }},
            handle: {{ p.handle | json }},
            productId: {{ p.id | json }},
            productTitle: {{ p.title | json }},
            variantId: {{ v.id | json }},
            variantTitle: {{ v.title | json }},
            price: {{ v.price | json }},
            available: {{ v.available | json }}
          };
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}

    return {
      _debug: {
        cfgType: {{ cfg_type | json }},
        cfgHandle: {{ cfg.handle | default: '' | json }},
        moBracket: {{ metaobjects[cfg_type].values.size | default: 0 | json }},
        moLiteral: {{ metaobjects.belt_builder_config.values.size | default: 0 | json }},
        strapsRaw: {{ bb_straps.size | default: 0 | json }},
        bucklesRaw: {{ bb_buckles.size | default: 0 | json }},
        collTitle: {{ combos_collection.title | default: '' | json }},
        collCount: {{ combos_collection.products.size | default: 0 | json }}
      },
      straps: straps, strapImages: strapImages, strapOrder: strapOrder,
      buckles: buckles, buckleImages: buckleImages, buckleOrder: buckleOrder,
      combos: combos
    };
  })();
</script>
