{%- comment -%}
  ----------------------------------------------------------------------------------------------------------------------
  MENU CAROUSEL COMPONENT
  ----------------------------------------------------------------------------------------------------------------------

  Render a heading, an optional link row and a horizontal row of products inside the menu drawer.

  ********************************************
  Supported variables
  ********************************************

  * block: the carousel block holding the collection and the text settings
{%- endcomment -%}

{%- liquid
  assign carousel_collection = collections[block.settings.collection]
  assign products_to_show = block.settings.products_to_show | default: 6
  assign carousel_link = block.settings.link | default: carousel_collection.url

  assign card_width = block.settings.card_width
  if card_width == blank
    assign card_width = 70
  endif

  assign image_ratio = block.settings.image_ratio
  if image_ratio == blank
    assign image_ratio = 'original'
  endif
-%}

<div class="menu-carousel" style="--menu-carousel-card-width: {{ card_width }}%;{% unless image_ratio == 'original' %}--menu-carousel-image-ratio: {{ image_ratio | replace: ':', ' / ' }};{% endunless %}">
  {%- if block.settings.heading != blank -%}
    <p class="menu-carousel__heading h5">{{ block.settings.heading }}</p>
  {%- endif -%}

  {%- if block.settings.subheading != blank -%}
    <a href="{{ carousel_link }}" class="menu-carousel__link link-faded">
      {{- block.settings.subheading -}}
      {%- render 'icon' with 'chevron-right', width: 12, direction_aware: true -%}
    </a>
  {%- endif -%}

  {%- if carousel_collection.products.size > 0 -%}
    <div class="menu-carousel__track">
      {%- for product in carousel_collection.products limit: products_to_show -%}
        <div class="menu-carousel__item {% if block.settings.price_below_name == false %}menu-carousel__item--overlay{% endif %}">
          {%- render 'product-card', product: product, position: forloop.index, show_quick_buy: false, show_badges: block.settings.show_badges -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
